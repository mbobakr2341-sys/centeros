function Icon({ type }) {
  const icons = {
    shield: "◈",
    chart: "▥",
    users: "◌",
    clock: "◷",
    settings: "◫",
    payments: "▣",
  };

  return <span className="feature-icon">{icons[type] || "•"}</span>;
}

