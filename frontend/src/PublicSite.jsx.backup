function Countdown({ t }) {
  const [remaining, setRemaining] = useState(() => Math.max(0, launchAt - Date.now()));

  useEffect(() => {
    const timer = setInterval(() => {
      setRemaining(Math.max(0, launchAt - Date.now()));
    }, 1000);

    return () => clearInterval(timer);
  }, []);

  const time = useMemo(() => {
    const total = Math.floor(remaining / 1000);

    return {
      days: Math.floor(total / 86400),
      hours: Math.floor((total % 86400) / 3600),
      minutes: Math.floor((total % 3600) / 60),
      seconds: total % 60,
    };
  }, [remaining]);

  return (
    <div className="launch-card">
      <div className="launch-title">{t.launch}</div>

      <div className="countdown">
        {[
          [time.days, t.days],
          [time.hours, t.hours],
          [time.minutes, t.minutes],
          [time.seconds, t.seconds],
        ].map(([value, label]) => (
          <div className="time-box" key={label}>
            <strong>{String(value).padStart(2, "0")}</strong>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>
  );
}

export default function PublicSite() {
  const [lang, setLang] = useState("ar");
  const [menuOpen, setMenuOpen] = useState(false);
  const [billing, setBilling] = useState("monthly");
  const [submitted, setSubmitted] = useState(false);

  const t = translations[lang];
  const currentPlans = plans[billing];

  useEffect(() => {
    document.documentElement.lang = lang;
    document.documentElement.dir = t.dir;
  }, [lang, t.dir]);

  const scrollTo = (id) => {
    setMenuOpen(false);
    document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });
  };

  const submitBooking = (event) => {
    event.preventDefault();
    setSubmitted(true);
  };

  return (
    <div className={`public-site lang-${lang}`}>
      <div className="ambient ambient-one" />
      <div className="ambient ambient-two" />

      <header className="site-header">
        <div className="container header-inner">
          <button className="brand" onClick={() => scrollTo("home")}>
            <img src="/logo.png" alt="CenterOS" />
            <span>CenterOS</span>
          </button>

          <nav className={menuOpen ? "nav open" : "nav"}>
            {t.nav.map((item, index) => {
              const ids = ["home", "features", "pricing", "about", "contact"];
              return (
                <button key={item} onClick={() => scrollTo(ids[index])}>
                  {item}
                </button>
              );
            })}
          </nav>

          <div className="header-actions">
            <div className="language-switcher">
              {["ar", "en", "tr"].map((code) => (
                <button
                  key={code}
                  className={lang === code ? "active" : ""}
                  onClick={() => setLang(code)}
                >
                  {code.toUpperCase()}
                </button>
              ))}
            </div>

            <button className="login-button">{t.login}</button>
            <button className="header-cta" onClick={() => scrollTo("contact")}>
              {t.cta}
            </button>
          </div>

          <button
            className="mobile-menu"
            onClick={() => setMenuOpen((value) => !value)}
            aria-label="Menu"
          >
            <span />
            <span />
            <span />
          </button>
        </div>
      </header>

      <main>
        <section id="home" className="hero-section">
          <div className="container hero-grid">
            <div className="hero-copy">
              <div className="hero-badge">{t.badge}</div>

              <h1>
                {t.heroTitle1}
                <span>{t.heroTitle2}</span>
              </h1>

              <p>{t.heroText}</p>

              <div className="hero-actions">
                <button className="primary-button" onClick={() => scrollTo("contact")}>
                  {t.heroPrimary}
                </button>

                <button className="secondary-button" onClick={() => scrollTo("features")}>
                  {t.heroSecondary}
                  <span>←</span>
                </button>
              </div>

              <Countdown t={t} />

              <div className="hero-trust">
                <span>إدارة واضحة</span>
                <span>بيانات منظمة</span>
                <span>تجربة احترافية</span>
              </div>
            </div>

            <DashboardMockup />
          </div>
        </section>

        <section id="features" className="section">
          <div className="container">
            <div className="section-heading">
              <span>CenterOS</span>
              <h2>{t.why}</h2>
              <p>{t.whyText}</p>
            </div>

            <div className="features-grid">
              {t.features.map(([number, title, text], index) => (
                <article className="feature-card" key={number}>
                  <div className="feature-number">{number}</div>
                  <Icon
                    type={
                      ["shield", "users", "payments", "chart", "settings", "users"][index]
                    }
                  />
                  <h3>{title}</h3>
                  <p>{text}</p>
                  <div className="card-line" />
                </article>
              ))}
            </div>
          </div>
        </section>

        <section id="pricing" className="section pricing-section">
          <div className="container">
            <div className="section-heading">
              <span>Pricing</span>
              <h2>{t.pricing}</h2>
              <p>{t.pricingText}</p>
            </div>

            <div className="billing-switch">
              <button
                className={billing === "monthly" ? "active" : ""}
                onClick={() => setBilling("monthly")}
              >
                {t.monthly}
              </button>
              <button
                className={billing === "yearly" ? "active" : ""}
                onClick={() => setBilling("yearly")}
              >
                {t.yearly}
              </button>
              <span>{t.save}</span>
            </div>

            <div className="pricing-grid">
              {currentPlans.map((plan) => (
                <article
                  key={plan.key}
                  className={`pricing-card ${plan.popular ? "popular" : ""} accent-${plan.accent}`}
                >
                  {plan.popular && <div className="popular-label">الأكثر طلباً</div>}

                  <div className="pricing-head">
                    <h3>{plan.name}</h3>
                    <p>{plan.subtitle}</p>
                  </div>

                  {plan.enterprise ? (
                    <div className="enterprise-price">{t.enterprisePrice}</div>
                  ) : (
                    <div className="price">
                      <strong>${plan.price}</strong>
                      <span>
                        / {billing === "monthly" ? t.month : t.year}
                      </span>
                    </div>
                  )}

                  {billing === "yearly" && !plan.enterprise && (
                    <div className="monthly-equivalent">
                      ${plan.monthlyEquivalent.toFixed(2)} / {t.month}
                    </div>
                  )}

                  <div className="pricing-divider" />

                  <ul>
                    {plan.features.map((feature) => (
                      <li key={feature}>
                        <span>✓</span>
                        {feature}
                      </li>
                    ))}
                  </ul>

                  <button
                    className="plan-button"
                    onClick={() => scrollTo("contact")}
                  >
                    {plan.enterprise ? t.enterpriseCta : t.choose}
                  </button>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section id="about" className="section about-section">
          <div className="container about-grid">
            <div className="about-visual">
              <div className="glass-panel">
                <div className="panel-orb" />
                <img src="/logo.png" alt="CenterOS" />
                <strong>CenterOS</strong>
                <span>Academy Management Platform</span>
              </div>
            </div>

            <div className="about-copy">
              <span>About</span>
              <h2>{t.about}</h2>
              <p>{t.aboutText}</p>

              <div className="about-points">
                <div>
                  <strong>01</strong>
                  <span>منصة واحدة لإدارة العمليات اليومية</span>
                </div>
                <div>
                  <strong>02</strong>
                  <span>قابلية للتوسع مع نمو الأكاديمية</span>
                </div>
                <div>
                  <strong>03</strong>
                  <span>تجربة واضحة للإدارة والموظفين</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="contact" className="section booking-section">
          <div className="container booking-container">
            <div className="booking-info">
              <span>CenterOS</span>
              <h2>{t.booking}</h2>
              <p>{t.bookingText}</p>

              <div className="contact-email">
                <small>{t.emailLabel}</small>
                <strong>centeros@centeros.online</strong>
              </div>
            </div>

            <form className="booking-form" onSubmit={submitBooking}>
              <div className="form-row">
                <label>
                  {t.name}
                  <input required type="text" />
                </label>

                <label>
                  {t.academy}
                  <input required type="text" />
                </label>
              </div>

              <div className="form-row">
                <label>
                  {t.email}
                  <input required type="email" />
                </label>

                <label>
                  {t.branches}
                  <input required type="number" min="1" />
                </label>
              </div>

              <label>
                {t.students}
                <input required type="number" min="1" />
              </label>

              <label>
                {t.notes}
                <textarea rows="4" />
              </label>

              {submitted && <div className="form-success">{t.success}</div>}

              <button className="primary-button form-submit" type="submit">
                {t.send}
              </button>

              <small className="form-note">
                سيتم استخدام البيانات للتواصل معك بخصوص CenterOS فقط.
              </small>
            </form>
          </div>
        </section>
      </main>

      <footer className="site-footer">
        <div className="container footer-inner">
          <div className="footer-brand">
            <img src="/logo.png" alt="CenterOS" />
            <div>
              <strong>CenterOS</strong>
              <p>{t.footer}</p>
            </div>
          </div>

          <div className="footer-email">
            <span>{t.emailLabel}</span>
            <strong>centeros@centeros.online</strong>
          </div>

          <div className="footer-copy">
            © {new Date().getFullYear()} CenterOS
          </div>
        </div>
      </footer>
    </div>
  );
}
