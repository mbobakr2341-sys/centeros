            {Array.from({ length: 20 }).map((_, i) => <span key={i} />)}
          </div>
          <div className="building-side" />
          <div className="building-door" />
        </div>
        <div className="building-trees tree-one" />
        <div className="building-trees tree-two" />
        <div className="building-trees tree-three" />
      </div>

      <div className="demo-label demo-label-top">Better Education<br />Brighter Future</div>

      <div className="demo-side-list">
        {[
          ["users", t.demoStudents],
          ["users", t.demoTeachers],
          ["book", t.demoCourses],
          ["chart", t.demoAttendance],
          ["payment", t.demoPayments],
        ].map(([icon, label]) => (
          <div key={label}><Icon name={icon} size={15} /><span>{label}</span></div>
        ))}
      </div>

      <div className="demo-chart">
        <div className="demo-chart-line">
          <span /><span /><span /><span /><span /><span />
        </div>
      </div>
    </div>
  );
}

function BookingModal({ language, t, onClose }) {
  const [form, setForm] = useState({
    managerName: "",
    centerName: "",
    email: "",
    branches: "",
    students: "",
    additionalInfo: "",
  });
  const [status, setStatus] = useState("idle");

  const studentsOptions = [
    "حتى 100 طالب",
    "حتى 200 طالب",
    "حتى 300 طالب",
    "حتى 400 طالب",
    "حتى 500 طالب",
    "أكثر من 500 طالب",
  ];

  const update = (key, value) => setForm((prev) => ({ ...prev, [key]: value }));

  const submit = async (e) => {
    e.preventDefault();

    if (!form.managerName || !form.centerName || !form.email || !form.branches || !form.students) {
      setStatus("required");
      return;
    }

    setStatus("loading");

    try {
      const response = await fetch("/api/booking", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: form.managerName,
          managerName: form.managerName,
          center: form.centerName,
          centerName: form.centerName,
          email: form.email,
          branches: form.branches,
          students: form.students,
          additionalInfo: form.additionalInfo,
          language,
        }),
      });

      if (!response.ok) throw new Error("booking_failed");

      setStatus("success");
    } catch {
      setStatus("error");
    }
  };

  const whatsappText = encodeURIComponent(
    `${t.bookNow} - ${form.centerName || "CenterOS"}\n${form.managerName || ""}\n${form.email || ""}`
  );

  return (
    <div className="modal-backdrop" onMouseDown={onClose}>
      <div className="booking-modal" onMouseDown={(e) => e.stopPropagation()}>
        <button className="modal-close" onClick={onClose} aria-label={t.close}>
          <Icon name="x" size={20} />
        </button>

        {status === "success" ? (
          <div className="modal-result">
            <div className="result-icon"><Icon name="check" size={30} /></div>
            <h2>{t.success}</h2>
            <p>{t.successText}</p>
            <a
              className="gradient-btn"
              href={`https://wa.me/20${WHATSAPP.slice(1)}?text=${whatsappText}`}
              target="_blank"
              rel="noreferrer"
            >
              {t.chatNow}
              <Icon name="arrow" size={17} />
            </a>
          </div>
        ) : (
          <>
            <div className="modal-heading">
              <span className="eyebrow">{t.book}</span>
              <h2>{t.formTitle}</h2>
              <p>{t.formText}</p>
            </div>

            {status === "required" && <div className="form-message warning">{t.required}</div>}
            {status === "error" && (
              <div className="form-message error">
                {t.error}{" "}
                <a href={`tel:${WHATSAPP}`}>{WHATSAPP}</a>
              </div>
            )}

            <form onSubmit={submit} className="booking-form">
              <div className="form-grid">
                <label>
                  <span>{t.manager}</span>
                  <input value={form.managerName} onChange={(e) => update("managerName", e.target.value)} required />
                </label>

                <label>
                  <span>{t.center}</span>
                  <input value={form.centerName} onChange={(e) => update("centerName", e.target.value)} required />
                </label>

                <label>
                  <span>{t.email}</span>
                  <input type="email" value={form.email} onChange={(e) => update("email", e.target.value)} required />
                </label>

                <label>
                  <span>{t.branches}</span>
                  <select value={form.branches} onChange={(e) => update("branches", e.target.value)} required>
                    <option value="">—</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4+</option>
                  </select>
                </label>

                <label>
                  <span>{t.expectedStudents}</span>
                  <select value={form.students} onChange={(e) => update("students", e.target.value)} required>
                    <option value="">—</option>
                    {studentsOptions.map((option) => <option key={option} value={option}>{option}</option>)}
                  </select>
                </label>

                <label className="full-field">
                  <span>{t.additional}</span>
                  <textarea rows="4" value={form.additionalInfo} onChange={(e) => update("additionalInfo", e.target.value)} />
                </label>
              </div>

              <button className="gradient-btn form-submit" disabled={status === "loading"}>
                {status === "loading" ? t.submitting : t.submit}
                <Icon name="arrow" size={17} />
              </button>
            </form>
          </>
        )}
      </div>
    </div>
  );
}

export default function PublicSite() {
  const [language, setLanguage] = useState("ar");
  const [billing, setBilling] = useState("monthly");
  const [menuOpen, setMenuOpen] = useState(false);
  const [modalOpen, setModalOpen] = useState(false);
  const [darkMode, setDarkMode] = useState(false);

  const t = copy[language];
  const isArabic = language === "ar";

  const launchDate = useMemo(() => new Date("2026-12-04T00:00:00+03:00"), []);

  const [timeLeft, setTimeLeft] = useState(() => {
    const diff = Math.max(0, launchDate.getTime() - Date.now());
    return {
      days: Math.floor(diff / 86400000),
      hours: Math.floor((diff / 3600000) % 24),
      minutes: Math.floor((diff / 60000) % 60),
      seconds: Math.floor((diff / 1000) % 60),
    };
  });

  useEffect(() => {
    document.documentElement.lang = language;
    document.documentElement.dir = isArabic ? "rtl" : "ltr";
  }, [language, isArabic]);

  useEffect(() => {
    const timer = setInterval(() => {
      const diff = Math.max(0, launchDate.getTime() - Date.now());
      setTimeLeft({
        days: Math.floor(diff / 86400000),
        hours: Math.floor((diff / 3600000) % 24),
        minutes: Math.floor((diff / 60000) % 60),
        seconds: Math.floor((diff / 1000) % 60),
      });
    }, 1000);
    return () => clearInterval(timer);
  }, [launchDate]);

  const scrollTo = (id) => {
    setMenuOpen(false);
    document.getElementById(id)?.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  const priceFor = (item) => {
    if (!item.price) return null;
    return billing === "yearly" ? Math.round(item.price * 0.8) : item.price;
  };

  return (
    <main className={`public-site ${darkMode ? "public-dark" : ""}`}>
      <div className="page-glow glow-a" />
      <div className="page-glow glow-b" />
      <div className="page-glow glow-c" />

      <header className="public-header">
        <div className="header-inner">
          <button className="brand" onClick={() => scrollTo("home")} aria-label="CenterOS">
            <img src="/newlogo.png" alt="CenterOS" />
          </button>

          <nav className={`main-nav ${menuOpen ? "open" : ""}`}>
            {[
              ["home", t.nav[0]],
              ["packages", t.nav[1]],
              ["about", t.nav[2]],
              ["contact", t.nav[3]],
            ].map(([id, label]) => (
              <button key={id} onClick={() => scrollTo(id)}>{label}</button>
            ))}
          </nav>

          <div className="header-actions">
            <div className="language-picker">
              <Icon name="globe" size={16} />
              <select value={language} onChange={(e) => setLanguage(e.target.value)} aria-label={t.language}>
                <option value="ar">العربية</option>
                <option value="en">English</option>
                <option value="tr">Türkçe</option>
              </select>
            </div>

            <button className="theme-btn" onClick={() => setDarkMode((v) => !v)} aria-label="Theme">
              <Icon name="moon" size={17} />
            </button>

            <button className="header-book" onClick={() => setModalOpen(true)}>
              <Icon name="calendar" size={16} />
              {t.book}
            </button>

            <button className="mobile-menu" onClick={() => setMenuOpen((v) => !v)}>
              <Icon name={menuOpen ? "x" : "menu"} size={21} />
            </button>
          </div>
        </div>
      </header>

      <section id="home" className="hero section-anchor">
        <div className="hero-content">
          <div className="hero-copy">
            <div className="hero-badge">
              <span className="badge-dot" />
              {t.badge}
            </div>

            <h1>
              {t.hero1}
              <br />
              {t.hero2}
              <br />
              <strong>{t.hero3}</strong>
            </h1>

            <p>{t.heroText}</p>

            <div className="hero-points">
              <span><i><Icon name="bolt" size={14} /></i>{t.easy}</span>
              <span><i><Icon name="shield" size={14} /></i>{t.secure}</span>
              <span><i><Icon name="users" size={14} /></i>{t.support}</span>
            </div>
          </div>

          <div className="hero-visual">
            <DemoDashboard t={t} />
          </div>
        </div>
      </section>

      <section id="about" className="features section-anchor">
        <div className="features-grid">
          {t.features.map(([title, text], index) => (
            <article className="feature-card" key={title}>
              <div className={`feature-icon icon-${index}`}>
                <Icon name={["shield", "bolt", "chart", "users"][index]} size={21} />
              </div>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="packages" className="packages-section section-anchor">
        <div className="section-heading">
          <div>
            <span className="section-kicker">{isArabic ? "الخطط والأسعار" : language === "tr" ? "PLANLAR VE FİYATLAR" : "PLANS & PRICING"}</span>
            <h2>{t.packages}</h2>
            <p>{t.packagesText}</p>
          </div>

          <div className="billing-switch">
            <button className={billing === "monthly" ? "active" : ""} onClick={() => setBilling("monthly")}>{t.monthly}</button>
            <button className={billing === "yearly" ? "active" : ""} onClick={() => setBilling("yearly")}>{t.yearly}</button>
            <span>{t.save}</span>
          </div>
        </div>

        <div className="packages-grid">
          {packages[language].map((item) => {
            const price = priceFor(item);
            return (
              <article className={`price-card ${item.popular ? "popular" : ""}`} key={item.name}>
                {item.popular && <div className="popular-label">{isArabic ? "الأكثر طلبًا" : language === "tr" ? "En Popüler" : "Most Popular"}</div>}

                <div className="price-top">
                  <div className="price-icon">
                    <Icon name={item.name === "Basic" ? "shield" : item.name === "Standard" ? "bolt" : item.name === "Pro" ? "building" : "chart"} size={22} />
                  </div>
                  <div>
                    <h3>{item.name}</h3>
                    <p>{item.subtitle}</p>
                  </div>
                </div>

                <div className="price">
                  {price ? (
                    <>
                      <strong>${price}</strong>
                      <span>{t.perMonth}</span>
                    </>
                  ) : (
                    <strong className="custom-price">{t.custom}</strong>
                  )}
                </div>

                <div className="price-divider" />

                <ul>
                  {item.items.map((feature) => (
                    <li key={feature}><span><Icon name="check" size={13} /></span>{feature}</li>
                  ))}
                </ul>

                <button className={item.popular ? "gradient-btn" : "outline-btn"} onClick={() => setModalOpen(true)}>
                  {item.price ? t.getStarted : t.contactUs}
                  <Icon name="arrow" size={16} />
                </button>
              </article>
            );
          })}
        </div>
      </section>

      <section className="action-strip">
        <div className="launch-card">
          <div className="strip-icon"><Icon name="bolt" size={20} /></div>
          <div className="strip-content">
            <h3>{t.launch}</h3>
            <div className="countdown">
              {[
                [timeLeft.days, t.days],
                [timeLeft.hours, t.hours],
                [timeLeft.minutes, t.minutes],
                [timeLeft.seconds, t.seconds],
              ].map(([value, label]) => (
                <div key={label}><strong>{String(value).padStart(2, "0")}</strong><span>{label}</span></div>
              ))}
            </div>
          </div>
        </div>

        <div className="action-card">
          <div className="strip-icon"><Icon name="calendar" size={20} /></div>
          <div>
            <h3>{t.callTitle}</h3>
            <p>{t.callText}</p>
            <button className="gradient-btn small" onClick={() => setModalOpen(true)}>{t.bookNow}<Icon name="arrow" size={15} /></button>
          </div>
        </div>

        <div className="action-card whatsapp-card">
          <div className="strip-icon whatsapp-icon"><Icon name="whatsapp" size={21} /></div>
          <div>
            <h3>{t.whatsappTitle}</h3>
            <p>{t.whatsappText}</p>
            <a
              className="whatsapp-btn"
              href={`https://wa.me/20${WHATSAPP.slice(1)}`}
              target="_blank"
              rel="noreferrer"
            >
              <Icon name="whatsapp" size={16} />
              {t.chatNow}
            </a>
          </div>
        </div>

        <div className="action-card language-card">
          <div className="strip-icon"><Icon name="globe" size={20} /></div>
          <div>
            <h3>{t.language}</h3>
            <div className="language-card-select">
              <select value={language} onChange={(e) => setLanguage(e.target.value)}>
                <option value="ar">العربية</option>
                <option value="en">English</option>
                <option value="tr">Türkçe</option>
              </select>
            </div>
            <button className="soft-btn" onClick={() => setModalOpen(true)}>{t.sendInfo}</button>
          </div>
        </div>
      </section>

      <section id="contact" className="contact-section section-anchor">
        <div className="contact-card">
          <div>
            <span className="section-kicker">{t.book}</span>
            <h2>{t.formTitle}</h2>
            <p>{t.formText}</p>
          </div>
          <button className="gradient-btn" onClick={() => setModalOpen(true)}>
            {t.bookNow}
            <Icon name="arrow" size={17} />
          </button>
        </div>
      </section>

      <footer className="public-footer">
        <div className="footer-brand">
          <img src="/newlogo.png" alt="CenterOS" />
          <div>
            <strong>Course CenterOS</strong>
            <span>{t.footer}</span>
          </div>
        </div>

        <div className="footer-links">
          <button onClick={() => scrollTo("home")}>{t.nav[0]}</button>
          <button onClick={() => scrollTo("packages")}>{t.nav[1]}</button>
          <button onClick={() => scrollTo("about")}>{t.nav[2]}</button>
          <button onClick={() => scrollTo("contact")}>{t.nav[3]}</button>
        </div>

        <div className="footer-copy">
          <span>© {new Date().getFullYear()} CenterOS</span>
          <span>{t.rights}</span>
        </div>
      </footer>

      {modalOpen && (
        <BookingModal
          language={language}
          t={t}
          onClose={() => setModalOpen(false)}
        />
      )}
    </main>
  );
}
