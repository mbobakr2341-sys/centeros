@import url("https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap");

:root {
  --navy: #07142f;
  --navy-2: #0b1d42;
  --purple: #5141e5;
  --purple-2: #735cf5;
  --blue: #2874e8;
  --light-blue: #edf3ff;
  --line: rgba(35, 54, 104, 0.12);
  --text: #101d3b;
  --muted: #65718a;
  --white: #ffffff;
  --glass: rgba(255, 255, 255, 0.72);
  --shadow: 0 24px 70px rgba(31, 50, 100, 0.12);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at 80% 5%, rgba(90, 70, 240, 0.11), transparent 28%),
    radial-gradient(circle at 10% 35%, rgba(35, 116, 232, 0.07), transparent 24%),
    #f8faff;
  color: var(--text);
  font-family: "Cairo", system-ui, sans-serif;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.public-site {
  min-height: 100vh;
  overflow: hidden;
  position: relative;
}

.container {
  width: min(1180px, calc(100% - 48px));
  margin: auto;
  position: relative;
  z-index: 2;
}

.ambient {
  position: absolute;
  border-radius: 50%;
  filter: blur(70px);
  pointer-events: none;
  opacity: 0.5;
}

.ambient-one {
  width: 420px;
  height: 420px;
  top: 300px;
  right: -220px;
  background: rgba(83, 65, 229, 0.16);
}

.ambient-two {
  width: 320px;
  height: 320px;
  top: 950px;
  left: -180px;
  background: rgba(43, 117, 232, 0.1);
}

/* HEADER */

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid rgba(25, 43, 85, 0.07);
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.header-inner {
  min-height: 78px;
  display: flex;
  align-items: center;
  gap: 30px;
}

.brand {
  border: 0;
  background: transparent;
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--navy);
  font-size: 21px;
  font-weight: 800;
  padding: 0;
  flex-shrink: 0;
}

.brand img {
  width: 40px;
  height: 40px;
  object-fit: contain;
}

.nav {
  display: flex;
  align-items: center;
  gap: 27px;
  margin-inline: auto;
}

.nav button {
  border: 0;
  background: transparent;
  color: #293653;
  font-size: 13px;
  font-weight: 600;
  transition: 0.25s ease;
}

.nav button:hover {
  color: var(--purple);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 9px;
}

.language-switcher {
  display: flex;
  padding: 3px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: rgba(255,255,255,.65);
}

.language-switcher button {
  border: 0;
  background: transparent;
  color: #78839a;
  border-radius: 9px;
  padding: 5px 7px;
  font-size: 10px;
  font-weight: 800;
}

.language-switcher button.active {
  color: var(--purple);
  background: #eef0ff;
}

.login-button,
.header-cta,
.primary-button,
.secondary-button,
.plan-button {
  border-radius: 11px;
  font-weight: 700;
  transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
}

.login-button {
  border: 1px solid var(--line);
  color: var(--navy);
  background: rgba(255,255,255,.75);
  padding: 11px 19px;
}

.header-cta,
.primary-button {
  border: 1px solid transparent;
  color: white;
  background: linear-gradient(135deg, #5541e5, #6b55ed);
  box-shadow: 0 12px 28px rgba(81, 65, 229, .25);
  padding: 12px 20px;
}

.login-button:hover,
.header-cta:hover,
.primary-button:hover,
.plan-button:hover {
  transform: translateY(-2px);
}

.mobile-menu {
  display: none;
  width: 42px;
  height: 42px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: white;
  padding: 9px;
}

.mobile-menu span {
  display: block;
  height: 2px;
  background: var(--navy);
  margin: 5px 0;
}

/* HERO */

.hero-section {
  padding: 74px 0 85px;
}

.hero-grid {
  display: grid;
  grid-template-columns: .84fr 1.16fr;
  gap: 45px;
  align-items: center;
}

.hero-copy {
  position: relative;
  z-index: 3;
}

.hero-badge {
  display: inline-flex;
  padding: 8px 13px;
  border-radius: 999px;
  background: rgba(82, 65, 229, .08);
  color: var(--purple);
  border: 1px solid rgba(82, 65, 229, .12);
  font-size: 11px;
  font-weight: 800;
  margin-bottom: 18px;
}

.hero-copy h1 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(42px, 5vw, 68px);
  line-height: 1.1;
  letter-spacing: -2px;
  font-weight: 800;
}

.hero-copy h1 span {
  display: block;
  color: var(--purple);
  margin-top: 5px;
}

.hero-copy > p {
  max-width: 590px;
  color: #5e6b83;
  font-size: 16px;
  line-height: 2;
  margin: 23px 0;
}

.hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.secondary-button {
  border: 1px solid rgba(81,65,229,.25);
  background: rgba(255,255,255,.7);
  color: var(--purple);
  padding: 12px 20px;
}

.secondary-button span {
  margin-inline-start: 8px;
}

.launch-card {
  width: min(100%, 470px);
  margin-top: 25px;
  padding: 15px;
  border: 1px solid rgba(82,65,229,.12);
  border-radius: 18px;
  background: rgba(255,255,255,.65);
  backdrop-filter: blur(20px);
  box-shadow: 0 16px 45px rgba(37, 53, 100, .08);
}

.launch-title {
  text-align: center;
  color: var(--navy);
  font-size: 12px;
  font-weight: 800;
  margin-bottom: 10px;
}

.countdown {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 7px;
}

.time-box {
  text-align: center;
  border-radius: 12px;
  padding: 9px 5px;
  background: rgba(244,246,255,.9);
  border: 1px solid rgba(81,65,229,.08);
}

.time-box strong {
  display: block;
  color: var(--purple);
  font-size: 24px;
  line-height: 1.1;
}

.time-box span {
  display: block;
  margin-top: 4px;
  color: #7c869b;
  font-size: 9px;
  font-weight: 600;
}

.hero-trust {
  display: flex;
  gap: 19px;
  flex-wrap: wrap;
  margin-top: 20px;
}

.hero-trust span {
  color: #6e7990;
  font-size: 10px;
  font-weight: 700;
}

.hero-trust span::before {
  content: "";
  width: 5px;
  height: 5px;
  display: inline-block;
  border-radius: 50%;
  background: var(--purple);
  margin-inline-end: 7px;
}

/* DASHBOARD MOCKUP */

.dashboard-stage {
  min-height: 550px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1400px;
}

.dashboard-glow {
  position: absolute;
  width: 85%;
  height: 70%;
  border-radius: 50%;
  background: rgba(87, 68, 235, .15);
  filter: blur(70px);
}

.dashboard-window {
  width: 100%;
  position: relative;
  border-radius: 23px;
  overflow: hidden;
  background: rgba(255,255,255,.86);
  border: 1px solid rgba(255,255,255,.95);
  box-shadow: 0 35px 90px rgba(25, 45, 94, .18);
  transform: rotateY(-4deg) rotateX(2deg);
  animation: dashboardFloat 6s ease-in-out infinite;
}

@keyframes dashboardFloat {
  0%,100% { transform: rotateY(-4deg) rotateX(2deg) translateY(0); }
  50% { transform: rotateY(-2deg) rotateX(1deg) translateY(-9px); }
}

.dashboard-topbar {
  height: 58px;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #edf0f6;
  background: rgba(255,255,255,.92);
}

.brand-mini {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--navy);
  font-size: 13px;
}

.brand-mini img {
  width: 27px;
  height: 27px;
  object-fit: contain;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.top-actions span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #dbe1ef;
}

.top-actions b {
  font-size: 9px;
  color: #59657e;
}

.dashboard-body {
  display: grid;
  grid-template-columns: 125px 1fr;
  min-height: 405px;
}

.dashboard-sidebar {
  padding: 18px 9px;
  border-inline-end: 1px solid #edf0f6;
  background: rgba(251,252,255,.88);
}

.dashboard-sidebar div {
  padding: 9px 11px;
  border-radius: 8px;
  color: #69758d;
  font-size: 9px;
  font-weight: 600;
  margin-bottom: 3px;
}

.dashboard-sidebar .side-active {
  color: var(--purple);
  background: #f0efff;
  font-weight: 800;
}

.dashboard-content {
  padding: 17px;
  background: linear-gradient(145deg, #fff, #f8f9ff);
}

.dashboard-welcome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px;
  border-radius: 13px;
  background: linear-gradient(135deg, #f1efff, #f7f8ff);
}

.dashboard-welcome small {
  color: var(--purple);
  font-size: 8px;
  font-weight: 800;
}

.dashboard-welcome h3 {
  margin: 4px 0;
  color: var(--navy);
  font-size: 16px;
}

.dashboard-welcome p {
  margin: 0;
  color: #79849a;
  font-size: 8px;
}

.mock-date {
  color: #68738a;
  background: white;
  padding: 7px 10px;
  border-radius: 7px;
  font-size: 8px;
}

.dashboard-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-top: 9px;
}

.dashboard-stats > div {
  padding: 12px;
  border: 1px solid #edf0f6;
  border-radius: 11px;
  background: white;
}

.dashboard-stats small {
  display: block;
  color: #8a94a8;
  font-size: 7px;
}

.dashboard-stats strong {
  display: block;
  color: var(--navy);
  font-size: 15px;
  margin-top: 3px;
}

.dashboard-stats em {
  font-style: normal;
  color: #35a46a;
  font-size: 7px;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 1.35fr .75fr;
  gap: 9px;
  margin-top: 9px;
}

.mock-chart,
.mock-list {
  border: 1px solid #edf0f6;
  border-radius: 11px;
  background: white;
  padding: 13px;
}

.mock-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mock-heading strong,
.mock-list > strong {
  font-size: 9px;
  color: var(--navy);
}

.mock-heading span {
  font-size: 7px;
  color: #8b95a8;
}

.chart-area {
  height: 170px;
  margin-top: 13px;
  border-radius: 8px;
  background:
    linear-gradient(rgba(82,65,229,.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(82,65,229,.05) 1px, transparent 1px);
  background-size: 28px 28px;
  position: relative;
  overflow: hidden;
}

.chart-line {
  position: absolute;
  inset: 35px 10px 25px;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.chart-line i {
  display: block;
  width: 8px;
  border-radius: 8px;
  background: linear-gradient(to top, var(--purple), #7a68fa);
  box-shadow: 0 5px 15px rgba(81,65,229,.2);
  animation: chartPulse 2.2s ease-in-out infinite alternate;
}

.chart-line i:nth-child(1) { height: 38%; }
.chart-line i:nth-child(2) { height: 61%; animation-delay: .1s; }
.chart-line i:nth-child(3) { height: 49%; animation-delay: .2s; }
.chart-line i:nth-child(4) { height: 76%; animation-delay: .3s; }
.chart-line i:nth-child(5) { height: 68%; animation-delay: .4s; }
.chart-line i:nth-child(6) { height: 91%; animation-delay: .5s; }
.chart-line i:nth-child(7) { height: 82%; animation-delay: .6s; }

@keyframes chartPulse {
  from { transform: scaleY(.82); }
  to { transform: scaleY(1); }
}

.mock-list > div {
  position: relative;
  padding: 11px 0 11px 15px;
  border-bottom: 1px solid #f0f2f6;
}

.mock-list p {
  margin: 0;
  color: #526079;
  font-size: 8px;
  line-height: 1.5;
}

.mock-list small {
  color: #9aa3b3;
  font-size: 6px;
}

.activity-dot {
  position: absolute;
  left: 0;
  top: 15px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--purple);
}

.floating-card {
  position: absolute;
  z-index: 5;
  padding: 14px 16px;
  border: 1px solid rgba(255,255,255,.95);
  border-radius: 15px;
  background: rgba(255,255,255,.78);
  backdrop-filter: blur(20px);
  box-shadow: 0 20px 45px rgba(31,48,94,.14);
  animation: cardFloat 5s ease-in-out infinite;
}

.floating-card small {
  display: block;
  color: #7b869a;
  font-size: 8px;
}

.floating-card strong {
  display: block;
  color: var(--navy);
  font-size: 18px;
  margin-top: 2px;
}

.floating-one {
  top: 10%;
  left: -18px;
}

.floating-one strong {
  color: var(--purple);
}

.floating-two {
  bottom: 9%;
  right: -15px;
  animation-delay: 1s;
}

.floating-two span {
  color: #39a66c;
  font-size: 8px;
  font-weight: 700;
}

.mini-progress {
  width: 95px;
  height: 5px;
  border-radius: 99px;
  background: #eceef5;
  margin-top: 7px;
}

.mini-progress i {
  display: block;
  width: 86%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--purple), #7c68f8);
}

@keyframes cardFloat {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* SECTIONS */

.section {
  padding: 95px 0;
}

.section-heading {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 45px;
}

.section-heading > span,
.about-copy > span,
.booking-info > span {
  color: var(--purple);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .5px;
}

.section-heading h2,
.about-copy h2,
.booking-info h2 {
  margin: 8px 0 10px;
  color: var(--navy);
  font-size: clamp(29px, 4vw, 43px);
  line-height: 1.25;
  font-weight: 800;
}

.section-heading p,
.about-copy p,
.booking-info p {
  color: var(--muted);
  line-height: 1.9;
  margin: 0;
}

/* FEATURES */

.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
}

.feature-card {
  position: relative;
  min-height: 235px;
  padding: 28px;
  border: 1px solid rgba(42,63,113,.1);
  border-radius: 20px;
  background: rgba(255,255,255,.68);
  backdrop-filter: blur(18px);
  box-shadow: 0 14px 45px rgba(31,50,100,.06);
  overflow: hidden;
  transition: .35s ease;
}

.feature-card:hover {
  transform: translateY(-7px);
  border-color: rgba(81,65,229,.2);
  box-shadow: 0 25px 55px rgba(31,50,100,.11);
}

.feature-number {
  position: absolute;
  top: 18px;
  inset-inline-end: 21px;
  color: rgba(81,65,229,.12);
  font-size: 31px;
  font-weight: 800;
}

.feature-icon {
  display: flex;
  width: 48px;
  height: 48px;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  color: var(--purple);
  background: #f0efff;
  font-size: 24px;
  margin-bottom: 18px;
}

.feature-card h3 {
  margin: 0 0 8px;
  color: var(--navy);
  font-size: 17px;
}

.feature-card p {
  margin: 0;
  color: #6c7890;
  font-size: 12px;
  line-height: 1.9;
}

.card-line {
  position: absolute;
  width: 65px;
  height: 2px;
  bottom: 0;
  inset-inline-start: 28px;
  background: linear-gradient(90deg, var(--purple), transparent);
}

/* PRICING */

.pricing-section {
  background: linear-gradient(180deg, rgba(243,246,255,.5), rgba(255,255,255,0));
}

.billing-switch {
  width: fit-content;
  margin: 0 auto 34px;
  display: flex;
  align-items: center;
  padding: 5px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(255,255,255,.76);
  box-shadow: 0 8px 25px rgba(30,50,100,.06);
}

.billing-switch button {
  border: 0;
  background: transparent;
  color: #7a8498;
  padding: 9px 17px;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 800;
}

.billing-switch button.active {
  color: white;
  background: var(--purple);
  box-shadow: 0 6px 16px rgba(81,65,229,.22);
}

.billing-switch > span {
  color: #31a069;
  font-size: 9px;
  font-weight: 800;
  margin-inline: 9px;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  align-items: stretch;
}

.pricing-card {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 27px 21px 20px;
  border: 1px solid #e5e9f1;
  border-radius: 19px;
  background: rgba(255,255,255,.83);
  box-shadow: 0 15px 45px rgba(35,55,100,.06);
  transition: .35s ease;
}

.pricing-card:hover {
  transform: translateY(-7px);
  box-shadow: 0 25px 60px rgba(35,55,100,.11);
}

.pricing-card.popular {
  border: 1.5px solid rgba(81,65,229,.5);
  box-shadow: 0 20px 60px rgba(81,65,229,.13);
}

.popular-label {
  position: absolute;
  top: -12px;
  inset-inline-start: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  color: white;
  background: var(--purple);
  border-radius: 99px;
  padding: 5px 12px;
  font-size: 9px;
  font-weight: 800;
}

.pricing-head h3 {
  margin: 0;
  color: var(--navy);
  font-size: 21px;
}

.pricing-head p {
  margin: 5px 0 19px;
  min-height: 35px;
  color: #8992a4;
  font-size: 10px;
}

.price strong {
  color: var(--purple);
  font-size: 35px;
  font-weight: 800;
  letter-spacing: -1px;
}

.price span {
  color: #8992a4;
  font-size: 10px;
}

.monthly-equivalent {
  color: #32a06a;
  font-size: 9px;
  font-weight: 800;
  margin-top: 3px;
}

.enterprise-price {
  color: #dd841d;
  font-size: 28px;
  font-weight: 800;
  min-height: 50px;
}

.pricing-divider {
  height: 1px;
  background: #edf0f5;
  margin: 17px 0;
}

.pricing-card ul {
  list-style: none;
  padding: 0;
  margin: 0 0 21px;
  flex: 1;
}

.pricing-card li {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  color: #5d6980;
  font-size: 10px;
  line-height: 1.55;
  margin-bottom: 8px;
}

.pricing-card li span {
  color: #32a06a;
  font-weight: 900;
}

.plan-button {
  width: 100%;
  padding: 11px;
  border: 1px solid rgba(81,65,229,.35);
  color: var(--purple);
  background: white;
  font-size: 11px;
}

.accent-green .price strong {
  color: #26965e;
}

.accent-green .plan-button {
  border-color: rgba(38,150,94,.35);
  color: #26965e;
}

.accent-blue .price strong {
  color: #216ac9;
}

.accent-blue .plan-button {
  border-color: rgba(33,106,201,.35);
  color: #216ac9;
}

.accent-orange .plan-button {
  border-color: rgba(221,132,29,.35);
  color: #d77e16;
}

/* ABOUT */

.about-grid {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  align-items: center;
  gap: 75px;
}

.about-visual {
  display: flex;
  justify-content: center;
}

.glass-panel {
  width: min(390px, 100%);
  height: 350px;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.9);
  border-radius: 30px;
  background: linear-gradient(145deg, rgba(255,255,255,.83), rgba(240,241,255,.7));
  backdrop-filter: blur(30px);
  box-shadow: var(--shadow);
}

.panel-orb {
  position: absolute;
  width: 230px;
  height: 230px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(81,65,229,.27), transparent 68%);
  filter: blur(5px);
}

.glass-panel img {
  width: 92px;
  height: 92px;
  object-fit: contain;
  position: relative;
}

.glass-panel strong {
  color: var(--navy);
  font-size: 27px;
  margin-top: 9px;
  position: relative;
}

.glass-panel > span {
  color: #7a8498;
  font-size: 10px;
  position: relative;
}

.about-copy p {
  max-width: 620px;
  font-size: 14px;
}

.about-points {
  margin-top: 27px;
  display: grid;
  gap: 12px;
}

.about-points div {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 13px 15px;
  border: 1px solid var(--line);
  border-radius: 13px;
  background: rgba(255,255,255,.6);
}

.about-points strong {
  color: var(--purple);
  font-size: 11px;
}

.about-points span {
  color: #5d6980;
  font-size: 11px;
}

/* BOOKING */

.booking-section {
  padding-top: 50px;
}

.booking-container {
  display: grid;
  grid-template-columns: .75fr 1.25fr;
  border-radius: 27px;
  overflow: hidden;
  background: linear-gradient(135deg, #5141e5, #3d55d7);
  box-shadow: 0 30px 75px rgba(56,61,175,.2);
}

.booking-info {
  padding: 55px 42px;
  color: white;
  position: relative;
  overflow: hidden;
}

.booking-info::after {
  content: "";
  position: absolute;
  width: 240px;
  height: 240px;
  border-radius: 50%;
  bottom: -120px;
  inset-inline-start: -80px;
  background: rgba(255,255,255,.08);
}

.booking-info > span {
  color: rgba(255,255,255,.75);
}

.booking-info h2 {
  color: white;
  font-size: 38px;
  margin-top: 10px;
}

.booking-info p {
  color: rgba(255,255,255,.75);
  font-size: 13px;
}

.contact-email {
  margin-top: 35px;
  position: relative;
  z-index: 2;
}

.contact-email small {
  display: block;
  color: rgba(255,255,255,.6);
  font-size: 9px;
}

.contact-email strong {
  display: block;
  margin-top: 5px;
  color: white;
  font-size: 12px;
}

.booking-form {
  padding: 38px;
  background: rgba(255,255,255,.97);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 13px;
}

.booking-form label {
  display: block;
  color: #4e5b74;
  font-size: 10px;
  font-weight: 700;
  margin-bottom: 13px;
}

.booking-form input,
.booking-form textarea {
  display: block;
  width: 100%;
  margin-top: 6px;
  padding: 11px 12px;
  border: 1px solid #e0e5ef;
  outline: none;
  border-radius: 10px;
  color: var(--navy);
  background: white;
  font-size: 11px;
  transition: .2s;
  resize: vertical;
}

.booking-form input:focus,
.booking-form textarea:focus {
  border-color: rgba(81,65,229,.55);
  box-shadow: 0 0 0 3px rgba(81,65,229,.08);
}

.form-submit {
  width: 100%;
  margin-top: 3px;
}

.form-note {
  display: block;
  color: #929bad;
  text-align: center;
  font-size: 8px;
  margin-top: 10px;
}

.form-success {
  margin-bottom: 12px;
  padding: 10px 12px;
  border-radius: 9px;
  color: #267e55;
  background: #edf9f2;
  font-size: 10px;
  font-weight: 700;
}

/* FOOTER */

.site-footer {
  padding: 28px 0;
  border-top: 1px solid var(--line);
  background: rgba(255,255,255,.75);
}

.footer-inner {
  display: grid;
  grid-template-columns: 1fr auto auto;
  align-items: center;
  gap: 35px;
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.footer-brand img {
  width: 38px;
  height: 38px;
  object-fit: contain;
}

.footer-brand strong {
  display: block;
  color: var(--navy);
  font-size: 15px;
}

.footer-brand p {
  margin: 2px 0 0;
  color: #8a94a7;
  font-size: 8px;
}

.footer-email span {
  display: block;
  color: #929bad;
  font-size: 8px;
}

.footer-email strong {
  color: var(--navy);
  font-size: 10px;
}

.footer-copy {
  color: #9ba3b2;
  font-size: 9px;
}

/* RTL */

.lang-ar .floating-one {
  left: auto;
  right: -18px;
}

.lang-ar .floating-two {
  right: auto;
  left: -15px;
}

.lang-ar .activity-dot {
  left: auto;
  right: 0;
}

.lang-ar .mock-list > div {
  padding-left: 0;
  padding-right: 15px;
}

/* RESPONSIVE */

@media (max-width: 1080px) {
  .header-inner {
    gap: 15px;
  }

  .nav {
    gap: 16px;
  }

  .nav button {
    font-size: 11px;
  }

  .pricing-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero-grid {
    grid-template-columns: .9fr 1.1fr;
  }
}

@media (max-width: 850px) {
  .container {
    width: min(100% - 30px, 680px);
  }

  .header-inner {
    min-height: 68px;
  }

  .nav {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 15px;
    right: 15px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(255,255,255,.94);
    backdrop-filter: blur(20px);
    box-shadow: var(--shadow);
  }

  .nav.open {
    display: grid;
  }

  .nav button {
    padding: 11px;
    text-align: start;
  }

  .header-actions .login-button,
  .header-actions .header-cta {
    display: none;
  }

  .mobile-menu {
    display: block;
  }

  .header-actions {
    margin-inline-start: auto;
  }

  .hero-section {
    padding-top: 50px;
  }

  .hero-grid {
    grid-template-columns: 1fr;
  }

  .hero-copy {
    text-align: center;
  }

  .hero-copy > p {
    margin-inline: auto;
  }

  .hero-actions,
  .hero-trust {
    justify-content: center;
  }

  .launch-card {
    margin-inline: auto;
  }

  .dashboard-stage {
    min-height: 460px;
  }

  .features-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-grid {
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .about-copy {
    text-align: center;
  }

  .about-copy p {
    margin-inline: auto;
  }

  .booking-container {
    grid-template-columns: 1fr;
  }

  .booking-info {
    padding: 40px 30px;
    text-align: center;
  }

  .contact-email {
    margin-top: 22px;
  }

  .footer-inner {
    grid-template-columns: 1fr;
    text-align: center;
    justify-items: center;
    gap: 15px;
  }
}

@media (max-width: 560px) {
  .container {
    width: min(100% - 22px, 470px);
  }

  .brand span {
    font-size: 18px;
  }

  .language-switcher button {
    padding: 5px 6px;
  }

  .hero-copy h1 {
    font-size: 39px;
    letter-spacing: -1px;
  }

  .hero-copy > p {
    font-size: 13px;
  }

  .hero-actions {
    flex-direction: column;
  }

  .hero-actions button {
    width: 100%;
  }

  .countdown {
    gap: 4px;
  }

  .time-box strong {
    font-size: 20px;
  }

  .dashboard-stage {
    min-height: 340px;
  }

  .dashboard-window {
    transform: none;
  }

  .dashboard-sidebar {
    display: none;
  }

  .dashboard-body {
    grid-template-columns: 1fr;
    min-height: 300px;
  }

  .dashboard-content {
    padding: 10px;
  }

  .dashboard-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .mock-list {
    display: none;
  }

  .chart-area {
    height: 105px;
  }

  .floating-card {
    padding: 9px 11px;
  }

  .floating-card strong {
    font-size: 14px;
  }

  .floating-one {
    top: 0;
    left: 0;
  }

  .floating-two {
    bottom: 0;
    right: 0;
  }

  .features-grid {
    grid-template-columns: 1fr;
  }

  .section {
    padding: 70px 0;
  }

  .pricing-grid {
    grid-template-columns: 1fr;
  }

  .pricing-card {
    padding: 25px 20px;
  }

  .billing-switch {
    width: 100%;
    justify-content: center;
  }

  .billing-switch > span {
    display: none;
  }

  .booking-form {
    padding: 25px 18px;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .booking-info h2 {
    font-size: 30px;
  }

  .glass-panel {
    height: 290px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}
