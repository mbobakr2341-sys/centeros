  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 9px;

  padding: 0 10px 10px;
}

.quick-card {
  position: relative;

  min-height: 76px;

  display: grid;

  grid-template-columns: 34px 1fr;

  grid-template-rows: auto auto;

  column-gap: 10px;

  padding: 12px;

  border: 1px solid rgba(115, 149, 198, 0.1);
  border-radius: 9px;

  background: rgba(255, 255, 255, 0.018);
}

.quick-card-icon {
  grid-row: 1 / 3;

  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 8px;
}

.quick-card-icon.purple {
  color: #e15ce8;
  background: rgba(181, 50, 182, 0.15);
}

.quick-card-icon.blue {
  color: #4bafff;
  background: rgba(37, 126, 218, 0.15);
}

.quick-card-icon.cyan {
  color: #82a0c8;
  background: rgba(83, 112, 153, 0.14);
}

.quick-card-icon.violet {
  color: #8e62ff;
  background: rgba(91, 57, 218, 0.15);
}

.quick-card > span {
  color: #718099;

  font-size: 8px;
  line-height: 1.35;
}

.quick-card strong {
  margin-top: 3px;

  color: #e9eff9;

  font-size: 21px;
  line-height: 1;
}

.quick-card small {
  position: absolute;

  right: 11px;
  bottom: 11px;

  font-size: 8px;
}

.dashboard-shell.rtl .quick-card small {
  right: auto;
  left: 11px;
}

.quick-card small.positive {
  color: #20d383;
}

.dashboard-footer {
  padding: 21px 0 3px;

  color: #596981;

  font-size: 9px;

  text-align: center;
}

.dashboard-footer span {
  color: #3d9cff;
}

.dashboard-empty-state {
  min-height: calc(100vh - 84px);

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 30px;

  text-align: center;
}

.dashboard-empty-icon {
  width: 72px;
  height: 72px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #5897f5;

  border: 1px solid rgba(70, 136, 232, 0.25);
  border-radius: 18px;

  background: rgba(43, 111, 220, 0.08);
}

.dashboard-empty-state h2 {
  margin: 20px 0 6px;

  color: #f1f5fc;

  font-size: 22px;
}

.dashboard-empty-state p {
  margin: 0;

  color: #687993;

  font-size: 11px;
}

.dashboard-overlay {
  display: none;
}

/* =========================================================
   DASHBOARD RTL
   ========================================================= */

.dashboard-shell.rtl {
  font-family:
    Cairo,
    Inter,
    system-ui,
    sans-serif;
}

.dashboard-shell.rtl .dashboard-main {
  direction: rtl;
}

.dashboard-shell.rtl .sidebar-nav-item {
  text-align: right;
}

.dashboard-shell.rtl .dashboard-search input {
  text-align: right;
}

.dashboard-shell.rtl .topbar-left {
  direction: rtl;
}

.dashboard-shell.rtl .topbar-actions {
  direction: ltr;
}

.dashboard-shell.rtl .dashboard-heading {
  direction: rtl;
}

.dashboard-shell.rtl .panel-header {
  direction: rtl;
}

.dashboard-shell.rtl .booking-item {
  direction: rtl;
}

.dashboard-shell.rtl .quick-card {
  direction: rtl;
}

.dashboard-shell.rtl .center-selector {
  direction: ltr;
}

/* =========================================================
   DASHBOARD TABLET
   ========================================================= */

@media (max-width: 1180px) {
  .dashboard-sidebar {
    width: 230px;
    min-width: 230px;
  }

  .sidebar-nav-item {
    padding: 0 12px;

    gap: 11px;

    font-size: 12px;
  }

  .dashboard-topbar {
    padding: 0 22px;
  }

  .dashboard-search {
    width: 300px;
  }

  .dashboard-content {
    padding: 23px 20px 17px;
  }

  .stats-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-right-column {
    display: grid;

    grid-template-columns:
      minmax(0, 1.35fr)
      minmax(0, 1fr);

    align-items: start;
  }
}

/* =========================================================
   DASHBOARD SMALL TABLET
   ========================================================= */

@media (max-width: 900px) {
  .dashboard-sidebar {
    position: fixed;

    top: 0;
    left: 0;

    height: 100vh;

    transform: translateX(-105%);

    transition: transform 230ms ease;

    box-shadow: 20px 0 60px rgba(0, 0, 0, 0.35);
  }

  .dashboard-sidebar.mobile-open {
    transform: translateX(0);
  }

  .dashboard-shell.rtl .dashboard-sidebar {
    left: auto;
    right: 0;

    transform: translateX(105%);

    border-left: 0;
  }

  .dashboard-shell.rtl .dashboard-sidebar.mobile-open {
    transform: translateX(0);
  }

  .dashboard-main {
    width: 100%;
  }

  .mobile-menu-button {
    width: 43px;
    height: 43px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    margin-right: 9px;

    color: #8c9bb2;

    border: 1px solid rgba(121, 151, 199, 0.13);
    border-radius: 10px;

    background: rgba(255, 255, 255, 0.025);

    cursor: pointer;
  }

  .dashboard-shell.rtl .mobile-menu-button {
    margin-right: 0;
    margin-left: 9px;
  }

  .dashboard-overlay {
    position: fixed;
    inset: 0;

    display: block;

    border: 0;

    background: rgba(0, 0, 0, 0.5);

    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);

    z-index: 35;
  }

  .dashboard-right-column {
    grid-template-columns: 1fr;
  }

  .dashboard-search {
    width: min(390px, 48vw);
  }

  .center-selector {
    display: none;
  }
}

/* =========================================================
   DASHBOARD MOBILE
   ========================================================= */

@media (max-width: 650px) {
  .dashboard-topbar {
    min-height: 70px;

    padding: 0 14px;

    gap: 10px;
  }

  .dashboard-search {
    width: min(100%, 260px);
    height: 42px;
  }

  .search-shortcut {
    display: none;
  }

  .topbar-actions {
    gap: 1px;
  }

  .topbar-icon-button {
    width: 37px;
    height: 37px;
  }

  .topbar-icon-button:first-of-type {
    display: none;
  }

  .dashboard-content {
    padding: 19px 13px 14px;
  }

  .dashboard-heading {
    align-items: flex-start;
    flex-direction: column;

    gap: 15px;

    margin-bottom: 18px;
  }

  .dashboard-heading h1 {
    font-size: 23px;
  }

  .dashboard-heading p {
    font-size: 10px;
  }

  .date-filter {
    width: 100%;

    justify-content: center;
  }

  .stats-grid {
    grid-template-columns: 1fr;

    gap: 10px;
  }

  .stat-card {
    min-height: 111px;

    padding: 18px;
  }

  .stat-icon {
    width: 43px;
    height: 43px;
  }

  .stat-value {
    font-size: 22px;
  }

  .dashboard-grid {
    gap: 12px;
  }

  .bottom-panels {
    grid-template-columns: 1fr;
  }

  .bookings-chart-panel {
    min-height: 315px;
  }

  .line-chart {
    height: 225px;

    padding: 6px 11px 16px;
  }

  .chart-svg {
    height: 170px;
  }

  .chart-x-axis {
    font-size: 7px;
  }

  .services-content {
    padding: 0 15px 19px;
  }

  .donut-chart {
    width: 125px;
    height: 125px;
  }

  .donut-chart::before {
    inset: 22px;
  }

  .booking-item {
    grid-template-columns:
      32px
      minmax(0, 1fr)
      auto;

    min-height: 65px;
  }

  .booking-time {
    grid-column: 2;
    grid-row: 2;

    margin-top: -12px;

    text-align: left;
  }

  .dashboard-shell.rtl .booking-time {
    text-align: right;
  }

  .booking-status {
    grid-column: 3;
    grid-row: 1;
  }

  .quick-grid {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   DASHBOARD VERY SMALL MOBILE
   ========================================================= */

@media (max-width: 400px) {
  .dashboard-search {
    flex: 1;
    width: auto;
  }

  .topbar-icon-button {
    display: none;
  }

  .dashboard-heading h1 {
    font-size: 21px;
  }

  .panel-header {
    min-height: 59px;

    padding: 0 13px;
  }

  .panel-header h2 {
    font-size: 12px;
  }

  .panel-select {
    height: 32px;

    font-size: 8px;
  }

  .services-content {
    flex-direction: column;
  }

  .services-list {
    width: 100%;
  }

  .donut-chart {
    width: 132px;
    height: 132px;
  }
}

/* =========================================================
   DASHBOARD LANDSCAPE MOBILE
   ========================================================= */

@media (
  max-height: 560px
) and (
  orientation: landscape
) {
  .dashboard-topbar {
    min-height: 62px;
  }

  .dashboard-content {
    padding-top: 16px;
  }

  .dashboard-heading {
    margin-bottom: 15px;
  }

  .stat-card {
    min-height: 100px;
  }
}

.booking-error-overlay {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(8, 15, 35, 0.55);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.booking-error-card {
  position: relative;
  width: min(440px, 100%);
  padding: 34px 28px 28px;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 24px 80px rgba(10, 25, 60, 0.25);
  animation: bookingErrorIn 0.25s ease-out;
}

.booking-error-close {
  position: absolute;
  top: 12px;
  left: 14px;
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 50%;
  background: #f1f4f9;
  color: #526078;
  font-size: 24px;
  line-height: 1;
  cursor: pointer;
}

.booking-error-icon {
  width: 58px;
  height: 58px;
  margin: 0 auto 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff1f1;
  color: #d92d20;
  font-size: 30px;
  font-weight: 800;
}

.booking-error-card h3 {
  margin: 0 0 12px;
  color: #101828;
  font-size: 23px;
}

.booking-error-card p {
  margin: 7px 0;
  color: #667085;
  font-size: 15px;
  line-height: 1.7;
}

.booking-error-phone {
  display: block;
  margin: 20px 0 14px;
  color: #155eef;
  font-size: 22px;
  font-weight: 800;
  text-decoration: none;
  direction: ltr;
}

.booking-error-dismiss {
  width: 100%;
  min-height: 48px;
  border: 0;
  border-radius: 12px;
  background: #101828;
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
}

@keyframes bookingErrorIn {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 480px) {
  .booking-error-card {
    padding: 30px 20px 22px;
    border-radius: 20px;
  }

  .booking-error-card h3 {
    font-size: 20px;
  }

  .booking-error-phone {
    font-size: 20px;
  }
}

