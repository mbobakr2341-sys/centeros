                      <div>
                        <small>{t.dashboard.subtitle}</small>
                        <strong>{t.dashboard.title}</strong>
                      </div>
                      <div className="mock-avatar" />
                    </div>

                    <div className="mock-stats">
                      <div><small>{t.dashboard.students}</small><strong>—</strong></div>
                      <div><small>{t.dashboard.teachers}</small><strong>—</strong></div>
                      <div><small>{t.dashboard.courses}</small><strong>—</strong></div>
                      <div><small>{t.dashboard.attendance}</small><strong>—</strong></div>
                    </div>

                    <div className="mock-panels">
                      <div className="mock-chart">
                        <div className="mock-panel-title">{t.dashboard.activity}</div>
                        <div className="chart-bars">
                          <i /><i /><i /><i /><i /><i /><i />
                        </div>
                      </div>
                      <div className="mock-side-panel">
                        <div className="mock-panel-title">{t.dashboard.revenue}</div>
                        <div className="mock-ring" />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="features" className="public-section features-section">
          <div className="public-container">
            <div className="section-heading">
              <span>{t.features.eyebrow}</span>
              <h2>{t.features.title}</h2>
              <p>{t.features.text}</p>
            </div>

            <div className="feature-grid">
              {t.features.items.map(([title, text], index) => (
                <article className="feature-card" key={title}>
                  <div className="feature-icon">
                    <Icon name={featureIcons[index]} />
                  </div>
                  <div>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </div>
                  <span className="feature-number">0{index + 1}</span>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section id="pricing" className="public-section pricing-section">
          <div className="public-container">
            <div className="section-heading">
              <span>{t.pricing.eyebrow}</span>
              <h2>{t.pricing.title}</h2>
              <p>{t.pricing.text}</p>
            </div>

            <div className="pricing-grid">
              {t.pricing.plans.map((plan) => (
                <article className={`pricing-card ${plan.popular ? "popular" : ""}`} key={plan.name}>
                  {plan.popular && (
                    <div className="popular-badge">
                      {language === "ar" ? "الأكثر طلبًا" : language === "tr" ? "En Popüler" : "Most Popular"}
                    </div>
                  )}

                  <div className="pricing-top">
                    <span className="plan-name">{plan.name}</span>
                    <p>{plan.desc}</p>
                    <div className="plan-price">
                      <strong>{plan.price}</strong>
                      {!plan.custom && <small>/ {t.pricing.monthly}</small>}
                    </div>
                  </div>

                  <div className="plan-limits">
                    {plan.limits.map((item) => <span key={item}>✓ {item}</span>)}
                  </div>

                  <div className="plan-features">
                    {plan.features.map((item) => <span key={item}>✓ {item}</span>)}
                  </div>

                  <button className={plan.popular ? "primary-button full" : "secondary-button full"} onClick={() => scrollTo("contact")}>
                    {plan.custom ? (language === "ar" ? "تواصل معنا" : language === "tr" ? "İletişime Geç" : "Contact Us") : t.cta}
                  </button>
                </article>
              ))}
            </div>

            <p className="pricing-note">{t.pricing.note}</p>
          </div>
        </section>

        <section id="about" className="public-section about-section">
          <div className="public-container about-grid">
            <div className="about-visual">
              <div className="about-orbit orbit-one" />
              <div className="about-orbit orbit-two" />
              <div className="about-logo-card">
                <img src="/logo.png" alt="CenterOS" />
                <strong>centerOS</strong>
                <span>Academy Management</span>
              </div>
            </div>

            <div className="about-copy">
              <div className="section-heading align-start">
                <span>{t.about.eyebrow}</span>
                <h2>{t.about.title}</h2>
                <p>{t.about.text}</p>
              </div>

              <div className="about-points">
                {t.about.points.map((point) => (
                  <div key={point}>
                    <span>✓</span>
                    <p>{point}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section id="contact" className="public-section contact-section">
          <div className="public-container contact-card">
            <div className="contact-copy">
              <div className="section-heading align-start">
                <span>{t.contact.eyebrow}</span>
                <h2>{t.contact.title}</h2>
                <p>{t.contact.text}</p>
              </div>

              <div className="contact-email">
                <span>✉</span>
                <div>
                  <small>Email</small>
                  <strong>{t.footer.email}</strong>
                </div>
              </div>
            </div>

            <form className="booking-form" onSubmit={submitForm}>
              <div className="form-row">
                <label>
                  <span>{t.contact.manager}</span>
                  <input
                    value={form.manager}
                    onChange={(e) => setForm({ ...form, manager: e.target.value })}
                    required
                  />
                </label>

                <label>
                  <span>{t.contact.academy}</span>
                  <input
                    value={form.academy}
                    onChange={(e) => setForm({ ...form, academy: e.target.value })}
                    required
                  />
                </label>
              </div>

              <div className="form-row">
                <label>
                  <span>{t.contact.email}</span>
                  <input
                    type="email"
                    value={form.email}
                    onChange={(e) => setForm({ ...form, email: e.target.value })}
                    required
                  />
                </label>

                <label>
                  <span>{t.contact.branches}</span>
                  <input
                    type="number"
                    min="1"
                    value={form.branches}
                    onChange={(e) => setForm({ ...form, branches: e.target.value })}
                    required
                  />
                </label>
              </div>

              <label>
                <span>{t.contact.students}</span>
                <input
                  type="number"
                  min="1"
                  value={form.students}
                  onChange={(e) => setForm({ ...form, students: e.target.value })}
                  required
                />
              </label>

              <label>
                <span>{t.contact.info}</span>
                <textarea
                  rows="4"
                  value={form.info}
                  onChange={(e) => setForm({ ...form, info: e.target.value })}
                />
              </label>

              <button type="submit" className="primary-button full">
                {t.contact.submit}
                <Icon name="arrow" />
              </button>

              <small className="form-privacy">{t.contact.privacy}</small>
            </form>
          </div>
        </section>
      </main>

      <footer className="public-footer">
        <div className="public-container footer-inner">
          <div className="footer-brand">
            <img src="/logo.png" alt="CenterOS" />
            <div>
              <strong>centerOS</strong>
              <p>{t.footer.description}</p>
            </div>
          </div>

          <div className="footer-links">
            <button onClick={() => scrollTo("features")}>{t.nav.features}</button>
            <button onClick={() => scrollTo("pricing")}>{t.nav.pricing}</button>
            <button onClick={() => scrollTo("about")}>{t.nav.about}</button>
            <button onClick={() => scrollTo("contact")}>{t.nav.contact}</button>
          </div>

          <div className="footer-contact">
            <a href="mailto:centeros@centeros.online">{t.footer.email}</a>
            <span>© {new Date().getFullYear()} CenterOS. {t.footer.rights}</span>
          </div>
        </div>
      </footer>
    </div>
  );
}
