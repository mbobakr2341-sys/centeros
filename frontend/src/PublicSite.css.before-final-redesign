/* =========================================================
   CenterOS Public Website
   Premium Glassmorphism Design
   ========================================================= */

:root {
  --cos-bg: #f5f3ff;
  --cos-bg-soft: #faf9ff;
  --cos-white: rgba(255, 255, 255, 0.78);
  --cos-white-strong: rgba(255, 255, 255, 0.92);
  --cos-border: rgba(120, 91, 220, 0.14);
  --cos-border-strong: rgba(111, 76, 255, 0.24);

  --cos-primary: #7048f5;
  --cos-primary-2: #8d5cff;
  --cos-blue: #35a9ff;
  --cos-purple-soft: #eee8ff;

  --cos-text: #16205c;
  --cos-text-2: #38416f;
  --cos-muted: #747c9f;

  --cos-green: #19bd7b;
  --cos-shadow: 0 18px 55px rgba(84, 64, 170, 0.11);
  --cos-shadow-soft: 0 10px 35px rgba(84, 64, 170, 0.07);

  --cos-radius-xl: 28px;
  --cos-radius-lg: 22px;
  --cos-radius-md: 17px;
  --cos-radius-sm: 12px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--cos-bg);
}

html,
body,
#root {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

body {
  min-height: 100vh;
  font-family:
    Inter,
    "Segoe UI",
    Tahoma,
    Arial,
    sans-serif;
  color: var(--cos-text);
  background:
    radial-gradient(circle at 15% 5%, rgba(121, 90, 255, 0.18), transparent 27%),
    radial-gradient(circle at 88% 20%, rgba(81, 169, 255, 0.14), transparent 26%),
    linear-gradient(135deg, #f6f4ff 0%, #ffffff 42%, #f1efff 100%);
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

/* =========================================================
   Main Shell
   ========================================================= */

.public-site {
  position: relative;
  isolation: isolate;
  min-height: 100vh;
  padding: 16px 0 22px;
}

.public-site::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -3;
  pointer-events: none;
  background:
    radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.82), transparent 42%),
    linear-gradient(
      125deg,
      rgba(123, 86, 255, 0.05),
      transparent 35%,
      rgba(73, 164, 255, 0.05)
    );
}

.site-background {
  position: fixed;
  inset: 0;
  z-index: -2;
  overflow: hidden;
  pointer-events: none;
}

.background-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(65px);
  opacity: 0.34;
}

.blob-purple {
  width: 430px;
  height: 430px;
  top: 7%;
  left: -180px;
  background: rgba(129, 88, 255, 0.24);
}

.blob-blue {
  width: 420px;
  height: 420px;
  right: -180px;
  top: 31%;
  background: rgba(70, 168, 255, 0.18);
}

.background-grid {
  position: absolute;
  inset: 0;
  opacity: 0.16;
  background-image:
    linear-gradient(rgba(116, 90, 214, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(116, 90, 214, 0.05) 1px, transparent 1px);
  background-size: 44px 44px;
  mask-image: linear-gradient(to bottom, black, transparent 80%);
}

.section-shell {
  position: relative;
  width: min(1140px, calc(100% - 56px));
  margin-inline: auto;
}

/* =========================================================
   Header
   ========================================================= */

.site-header {
  position: sticky;
  top: 14px;
  z-index: 100;
  width: min(1115px, calc(100% - 70px));
  margin: 0 auto;
}

.site-nav {
  min-height: 62px;
  padding: 8px 12px 8px 20px;

  display: flex;
  align-items: center;
  gap: 18px;

  border: 1px solid rgba(255, 255, 255, 0.72);
  border-radius: 22px;

  background: rgba(255, 255, 255, 0.66);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);

  box-shadow:
    0 12px 35px rgba(67, 49, 145, 0.09),
    inset 0 1px 0 rgba(255, 255, 255, 0.85);
}

.site-logo {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8px;

  border: 0;
  padding: 0;
  background: transparent;
  color: var(--cos-text);
  text-align: left;
}

.site-logo img {
  width: 42px;
  height: 42px;
  object-fit: contain;
  display: block;
  flex: 0 0 42px;
}

.site-logo span {
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.site-logo strong {
  font-size: 14px;
  font-weight: 800;
  letter-spacing: -0.35px;
}

.site-logo b {
  margin-top: 3px;
  font-size: 15px;
  font-weight: 800;
  color: var(--cos-primary);
}

.main-nav {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.main-nav button {
  border: 0;
  border-radius: 11px;
  padding: 9px 14px;
  background: transparent;

  color: #4c5479;
  font-size: 12px;
  font-weight: 650;

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.main-nav button:hover,
.main-nav button:first-child {
  color: var(--cos-primary);
  background: rgba(112, 72, 245, 0.09);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
}

.language-switcher {
  min-height: 36px;
  display: flex;
  align-items: center;
  gap: 1px;
  padding: 3px 5px;

  border: 1px solid rgba(120, 91, 220, 0.1);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.67);
}

.language-switcher .site-icon {
  margin-inline: 3px;
}

.language-switcher button {
  min-width: 29px;
  min-height: 28px;
  padding: 4px 6px;

  border: 0;
  border-radius: 8px;
  background: transparent;

  color: #697292;
  font-size: 9px;
  font-weight: 800;
}

.language-switcher button.active {
  color: var(--cos-primary);
  background: rgba(112, 72, 245, 0.1);
}

.theme-button {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;

  border: 1px solid rgba(120, 91, 220, 0.1);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.67);
  color: #4c5479;
}

.header-call-button {
  min-height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  border: 0;
  border-radius: 13px;
  padding: 0 16px;

  color: white;
  background: linear-gradient(100deg, #7547f5, #9a57ff);

  box-shadow: 0 8px 20px rgba(113, 71, 245, 0.22);

  font-size: 11px;
  font-weight: 750;

  transition:
    box-shadow 0.2s ease,
    filter 0.2s ease;
}

.header-call-button:hover {
  filter: brightness(1.04);
  box-shadow: 0 11px 25px rgba(113, 71, 245, 0.29);
}

.mobile-menu-button {
  display: none;
  width: 38px;
  height: 38px;
  padding: 8px;

  border: 1px solid var(--cos-border);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.75);
}

.mobile-menu-button span {
  display: block;
  width: 20px;
  height: 2px;
  margin: 4px auto;
  border-radius: 10px;
  background: var(--cos-primary);
}

/* =========================================================
   Icons
   ========================================================= */

.site-icon {
  width: var(--icon-size, 20px);
  height: var(--icon-size, 20px);
  min-width: var(--icon-size, 20px);

  display: inline-grid;
  place-items: center;

  color: var(--cos-primary);
  font-size: calc(var(--icon-size, 20px) * 0.72);
  line-height: 1;
  font-weight: 900;
}

.site-icon-whatsapp {
  color: #13b977;
}

/* =========================================================
   Hero
   ========================================================= */

.hero-section {
  margin-top: 22px;
  padding: 56px 34px 0;

  min-height: 420px;

  border-radius: 31px;

  background:
    radial-gradient(circle at 83% 52%, rgba(160, 123, 255, 0.24), transparent 31%),
    radial-gradient(circle at 72% 85%, rgba(73, 177, 255, 0.11), transparent 31%),
    linear-gradient(105deg, rgba(255, 255, 255, 0.78), rgba(244, 240, 255, 0.66));

  border: 1px solid rgba(255, 255, 255, 0.78);

  box-shadow:
    0 20px 70px rgba(87, 65, 170, 0.09),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);

  overflow: hidden;
}

.hero-section::after {
  content: "";
  position: absolute;
  right: -100px;
  top: -170px;
  width: 480px;
  height: 480px;
  border-radius: 50%;
  border: 1px solid rgba(119, 81, 242, 0.1);
  box-shadow:
    0 0 0 45px rgba(119, 81, 242, 0.025),
    0 0 0 90px rgba(119, 81, 242, 0.018);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 2;

  display: grid;
  grid-template-columns: 42% 58%;
  align-items: center;

  min-height: 370px;
}

.hero-copy {
  position: relative;
  z-index: 4;
  padding: 0 12px 24px;
}

.hero-badge {
  width: fit-content;
  display: inline-flex;
  align-items: center;
  gap: 7px;

  margin-bottom: 15px;
  padding: 7px 11px;

  border: 1px solid rgba(113, 72, 245, 0.1);
  border-radius: 20px;

  background: rgba(255, 255, 255, 0.64);
  box-shadow: 0 5px 18px rgba(92, 68, 173, 0.05);

  color: var(--cos-primary);
  font-size: 9px;
  font-weight: 750;
}

.badge-spark {
  font-size: 12px;
}

.hero-copy h1 {
  max-width: 490px;
  margin: 0;

  color: var(--cos-text);

  font-size: clamp(36px, 4vw, 54px);
  line-height: 1.03;
  letter-spacing: -2.5px;
  font-weight: 850;
}

.hero-copy h1 span {
  display: inline-block;

  background: linear-gradient(
    90deg,
    #6740ee 0%,
    #864bff 50%,
    #3daaff 100%
  );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-copy > p {
  max-width: 475px;
  margin: 19px 0 20px;

  color: #596180;
  font-size: 12px;
  line-height: 1.75;
  font-weight: 500;
}

.hero-benefits {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}

.hero-benefits > div {
  display: flex;
  align-items: center;
  gap: 7px;

  color: #596180;
  font-size: 9px;
  font-weight: 700;
}

.hero-benefits > div .site-icon {
  width: 25px;
  height: 25px;
  min-width: 25px;

  border-radius: 50%;
  background: rgba(113, 72, 245, 0.08);
}

/* =========================================================
   Hero Mockup
   ========================================================= */

.hero-visual {
  position: relative;
  height: 355px;
  min-width: 0;
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(4px);
}

.orb-one {
  width: 280px;
  height: 280px;
  right: 10%;
  top: 25px;
  background:
    radial-gradient(circle at 30% 30%, rgba(200, 171, 255, 0.48), transparent 58%),
    rgba(115, 75, 243, 0.1);
}

.orb-two {
  width: 220px;
  height: 220px;
  right: 0;
  bottom: -20px;
  background: rgba(76, 171, 255, 0.1);
}

.mockup-main {
  position: absolute;
  width: 80%;
  right: 7%;
  top: 25px;

  border: 1px solid rgba(255, 255, 255, 0.82);
  border-radius: 19px;

  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  box-shadow:
    0 25px 55px rgba(74, 54, 153, 0.14),
    inset 0 1px 0 rgba(255, 255, 255, 0.92);

  transform: rotate(-1.2deg);
  overflow: hidden;
}

.mockup-top {
  height: 45px;
  padding: 0 14px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid rgba(100, 77, 179, 0.08);
  background: rgba(255, 255, 255, 0.58);
}

.mockup-brand {
  display: flex;
  align-items: center;
  gap: 6px;
}

.mockup-brand img {
  width: 25px;
  height: 25px;
  object-fit: contain;
}

.mockup-brand div {
  display: flex;
  flex-direction: column;
}

.mockup-brand strong {
  font-size: 8px;
  color: var(--cos-text);
}

.mockup-brand span {
  margin-top: 2px;
  font-size: 6px;
  color: #8990ad;
}

.mockup-dots {
  display: flex;
  gap: 4px;
}

.mockup-dots span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #b7b8ca;
}

.mockup-body {
  display: grid;
  grid-template-columns: 105px 1fr;
  min-height: 250px;
}

.mockup-sidebar {
  padding: 13px 8px;
  border-right: 1px solid rgba(100, 77, 179, 0.07);
  background: rgba(246, 243, 255, 0.58);
}

.mock-nav {
  display: flex;
  align-items: center;
  gap: 7px;

  padding: 8px 7px;
  margin-bottom: 3px;

  border-radius: 7px;

  color: #727a9c;
  font-size: 7px;
  font-weight: 650;
}

.mock-nav.active {
  color: var(--cos-primary);
  background: rgba(112, 72, 245, 0.1);
}

.mock-content {
  padding: 15px;
  min-width: 0;
}

.mock-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 11px;
}

.mock-heading div {
  display: flex;
  flex-direction: column;
}

.mock-heading span {
  font-size: 6px;
  color: #8b91ae;
}

.mock-heading strong {
  margin-top: 3px;
  font-size: 10px;
  color: var(--cos-text);
}

.mock-heading button {
  border: 1px solid rgba(112, 72, 245, 0.1);
  border-radius: 7px;
  padding: 5px 7px;

  background: rgba(255, 255, 255, 0.8);
  color: #727a9c;

  font-size: 6px;
}

.mock-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 7px;
  margin-bottom: 9px;
}

.mock-stats > div {
  min-width: 0;
  padding: 8px;

  border: 1px solid rgba(111, 84, 194, 0.08);
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.7);
}

.mock-stats span {
  display: block;
  color: #8c92ad;
  font-size: 6px;
}

.mock-stats strong {
  display: inline-block;
  margin-top: 3px;
  color: var(--cos-text);
  font-size: 11px;
}

.mock-stats small {
  margin-left: 3px;
  color: #19ae78;
  font-size: 5px;
  font-weight: 800;
}

.mock-chart-card {
  padding: 9px 10px;

  border: 1px solid rgba(111, 84, 194, 0.08);
  border-radius: 10px;

  background: rgba(255, 255, 255, 0.68);
}

.mock-chart-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.mock-chart-head strong {
  font-size: 7px;
  color: var(--cos-text);
}

.mock-chart-head span {
  font-size: 6px;
  color: #8b91ad;
}

.mock-chart {
  width: 100%;
  height: 90px;
  display: block;
}

.floating-stat {
  position: absolute;
  z-index: 5;

  display: flex;
  align-items: center;
  gap: 8px;

  padding: 9px 12px;

  border: 1px solid rgba(255, 255, 255, 0.84);
  border-radius: 13px;

  background: rgba(255, 255, 255, 0.83);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);

  box-shadow: 0 14px 35px rgba(69, 48, 147, 0.12);
}

.floating-students {
  top: 24px;
  right: 3%;
}

.floating-icon {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;

  border-radius: 10px;
  background: rgba(112, 72, 245, 0.1);
}

.floating-stat > div:nth-child(2) {
  display: flex;
  flex-direction: column;
}

.floating-stat span {
  color: #858ca9;
  font-size: 6px;
}

.floating-stat strong {
  margin-top: 2px;
  color: var(--cos-text);
  font-size: 12px;
}

.floating-stat > b {
  color: #1ab77c;
  font-size: 7px;
}

.floating-chart {
  top: 92px;
  left: 2%;
  width: 104px;
  height: 54px;
  padding: 8px;
}

.mini-chart {
  width: 100%;
  height: 100%;
}

.mini-chart svg {
  width: 100%;
  height: 100%;
}

.floating-menu {
  position: absolute;
  z-index: 6;

  right: 1%;
  bottom: 21px;

  display: flex;
  flex-direction: column;
  gap: 5px;
}

.floating-menu div {
  min-width: 100px;
  display: flex;
  align-items: center;
  gap: 6px;

  padding: 7px 9px;

  border: 1px solid rgba(255, 255, 255, 0.84);
  border-radius: 10px;

  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  box-shadow: 0 8px 20px rgba(69, 48, 147, 0.07);

  color: #66708f;
  font-size: 6px;
  font-weight: 700;
}

.mockup-message {
  position: absolute;
  z-index: 6;

  top: 106px;
  right: 16%;

  padding: 9px 11px;

  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.85);

  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(12px);

  color: var(--cos-text);
  font-size: 7px;
  line-height: 1.5;
  font-weight: 800;

  box-shadow: 0 10px 25px rgba(69, 48, 147, 0.07);
}

.hero-bottom-line {
  width: 100%;
  height: 1px;
  margin-top: 5px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(112, 72, 245, 0.18),
    transparent
  );
}

/* =========================================================
   Features
   ========================================================= */

.features-section {
  margin-top: 10px;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.feature-card {
  min-height: 104px;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 17px;

  border: 1px solid rgba(255, 255, 255, 0.86);
  border-radius: 17px;

  background: rgba(255, 255, 255, 0.73);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  box-shadow:
    var(--cos-shadow-soft),
    inset 0 1px 0 rgba(255, 255, 255, 0.85);
}

.feature-icon {
  width: 45px;
  height: 45px;
  min-width: 45px;

  display: grid;
  place-items: center;

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      rgba(112, 72, 245, 0.12),
      rgba(72, 158, 255, 0.08)
    );

  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.9),
    0 7px 17px rgba(94, 66, 184, 0.06);
}

.feature-card h3 {
  margin: 0 0 6px;

  color: var(--cos-text);
  font-size: 11px;
  font-weight: 800;
}

.feature-card p {
  margin: 0;

  color: #7a829f;
  font-size: 8px;
  line-height: 1.55;
}

/* =========================================================
   Packages
   ========================================================= */

.packages-section {
  margin-top: 10px;
  padding: 24px 27px 25px;

  border: 1px solid rgba(255, 255, 255, 0.86);
  border-radius: 25px;

  background: rgba(255, 255, 255, 0.63);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  box-shadow:
    var(--cos-shadow),
    inset 0 1px 0 rgba(255, 255, 255, 0.92);
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.section-heading h2 {
  margin: 0;

  color: var(--cos-text);
  font-size: 27px;
  letter-spacing: -1px;
  font-weight: 850;
}

.section-heading p {
  max-width: 460px;
  margin: 7px 0 8px;

  color: #707995;
  font-size: 9px;
  line-height: 1.65;
}

.heading-line {
  position: relative;
  display: block;
  width: 36px;
  height: 2px;
  border-radius: 20px;
  background: var(--cos-primary);
}

.heading-line::after {
  content: "";
  position: absolute;
  right: -7px;
  top: -1px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #35a9ff;
}

.billing-switch {
  display: flex;
  align-items: center;
  gap: 2px;

  padding: 4px;

  border: 1px solid rgba(112, 72, 245, 0.09);
  border-radius: 13px;

  background: rgba(255, 255, 255, 0.72);
}

.billing-switch button {
  min-width: 72px;
  height: 31px;

  border: 0;
  border-radius: 10px;

  background: transparent;
  color: #777f9d;

  font-size: 8px;
  font-weight: 750;
}

.billing-switch button.active {
  color: white;
  background: linear-gradient(100deg, #7548f5, #9357ff);
  box-shadow: 0 7px 17px rgba(112, 72, 245, 0.18);
}

.billing-switch > span {
  margin: 0 5px;
  padding: 5px 7px;

  border-radius: 8px;

  color: #0ca66c;
  background: rgba(25, 189, 123, 0.1);

  font-size: 7px;
  font-weight: 850;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.pricing-card {
  position: relative;
  min-width: 0;
  min-height: 300px;

  display: flex;
  flex-direction: column;

  padding: 19px;

  border: 1px solid rgba(110, 85, 191, 0.1);
  border-radius: 17px;

  background: rgba(255, 255, 255, 0.76);

  box-shadow:
    0 9px 25px rgba(77, 57, 151, 0.055),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.pricing-card.popular {
  border-color: rgba(112, 72, 245, 0.34);

  box-shadow:
    0 13px 32px rgba(112, 72, 245, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.popular-label {
  position: absolute;
  top: -10px;
  right: 12px;

  padding: 5px 9px;

  border-radius: 7px;

  color: white;
  background: linear-gradient(100deg, #7446f5, #8b52ff);

  font-size: 7px;
  font-weight: 800;

  box-shadow: 0 6px 16px rgba(112, 72, 245, 0.2);
}

.pricing-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;

  margin-bottom: 11px;

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      rgba(112, 72, 245, 0.12),
      rgba(80, 168, 255, 0.08)
    );
}

.pricing-icon span {
  color: var(--cos-primary);
  font-size: 22px;
  font-weight: 900;
}

.pricing-card h3 {
  margin: 0;

  color: var(--cos-text);
  font-size: 14px;
  font-weight: 850;
}

.pricing-card > p {
  min-height: 28px;
  margin: 4px 0 12px;

  color: #8188a4;
  font-size: 8px;
  line-height: 1.45;
}

.pricing-price {
  display: flex;
  align-items: baseline;
  gap: 4px;
  min-height: 38px;
}

.pricing-price strong {
  color: var(--cos-text);
  font-size: 24px;
  line-height: 1;
  letter-spacing: -1px;
  font-weight: 850;
}

.pricing-price span {
  color: #7f87a3;
  font-size: 7px;
}

.pricing-divider {
  height: 1px;
  margin: 10px 0;

  background: linear-gradient(
    90deg,
    rgba(110, 85, 191, 0.13),
    transparent
  );
}

.pricing-card ul {
  display: flex;
  flex-direction: column;
  gap: 7px;

  padding: 0;
  margin: 0 0 15px;

  list-style: none;
}

.pricing-card li {
  display: flex;
  align-items: flex-start;
  gap: 6px;

  color: #737b9b;
  font-size: 7px;
  line-height: 1.35;
}

.pricing-card li .site-icon {
  flex: 0 0 auto;
  color: #1ab77c;
}

.pricing-button {
  width: 100%;
  min-height: 35px;
  margin-top: auto;

  border: 1px solid rgba(112, 72, 245, 0.25);
  border-radius: 10px;

  background: transparent;
  color: var(--cos-primary);

  font-size: 8px;
  font-weight: 800;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    box-shadow 0.2s ease;
}

.pricing-card.popular .pricing-button {
  color: white;
  border-color: transparent;
  background: linear-gradient(100deg, #7748f6, #35a8ff);
  box-shadow: 0 8px 19px rgba(100, 76, 219, 0.2);
}

.pricing-button:hover {
  color: white;
  border-color: transparent;
  background: linear-gradient(100deg, #7548f5, #35a8ff);
}

/* =========================================================
   Bottom Tools
   ========================================================= */

.bottom-tools {
  margin-top: 10px;

  display: grid;
  grid-template-columns: 1.25fr 1fr 1fr 1fr;
  gap: 14px;
}

.tool-card {
  min-width: 0;
  min-height: 125px;

  display: flex;
  gap: 12px;

  padding: 16px;

  border: 1px solid rgba(255, 255, 255, 0.87);
  border-radius: 17px;

  background: rgba(255, 255, 255, 0.71);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  box-shadow:
    var(--cos-shadow-soft),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.tool-card-heading {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;

  color: #5c6587;
  font-size: 8px;
  font-weight: 800;
}

.countdown-card {
  display: block;
}

.tool-icon {
  width: 38px;
  height: 38px;
  min-width: 38px;

  display: grid;
  place-items: center;

  border-radius: 12px;
  background: rgba(112, 72, 245, 0.09);
}

.countdown-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 5px;
}

.countdown-grid > div {
  min-width: 0;
  padding: 9px 5px;
  text-align: center;

  border-radius: 9px;
  background: rgba(246, 244, 255, 0.74);
}

.countdown-grid strong {
  display: block;
  color: var(--cos-text);
  font-size: 19px;
  line-height: 1;
}

.countdown-grid span {
  display: block;
  margin-top: 5px;
  color: #8b91ab;
  font-size: 6px;
  font-weight: 650;
}

.call-card h3,
.whatsapp-card h3,
.language-card h3 {
  margin: 1px 0 5px;

  color: var(--cos-text);
  font-size: 10px;
  font-weight: 850;
}

.call-card p,
.whatsapp-card p {
  max-width: 175px;
  margin: 0 0 9px;

  color: #858ca6;
  font-size: 7px;
  line-height: 1.55;
}

.call-card button,
.whatsapp-card a {
  min-height: 28px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;

  padding: 0 12px;

  border: 0;
  border-radius: 9px;

  color: white;
  background: linear-gradient(100deg, #7548f5, #39aaff);

  font-size: 7px;
  font-weight: 800;
}

.whatsapp-card a {
  background: linear-gradient(100deg, #0fc180, #21d698);
}

.whatsapp-icon {
  background: rgba(22, 192, 128, 0.09);
}

.language-card {
  display: grid;
  grid-template-columns: 38px 1fr;
}

.language-select {
  margin-top: 7px;

  display: flex;
  flex-direction: column;
  gap: 3px;
}

.language-select button {
  width: 100%;
  min-height: 26px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 9px;

  border: 1px solid rgba(112, 72, 245, 0.08);
  border-radius: 8px;

  background: rgba(255, 255, 255, 0.64);
  color: #747c99;

  font-size: 7px;
  text-align: start;
}

.language-select button.selected {
  color: var(--cos-primary);
  background: rgba(112, 72, 245, 0.07);
}

.information-button {
  width: 100%;
  min-height: 26px;

  margin-top: 5px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;

  border: 1px solid rgba(112, 72, 245, 0.16);
  border-radius: 8px;

  background: transparent;
  color: var(--cos-primary);

  font-size: 7px;
  font-weight: 750;
}

/* =========================================================
   Footer
   ========================================================= */

.site-footer {
  width: min(1140px, calc(100% - 56px));
  margin: 10px auto 0;
}

.footer-inner {
  min-height: 64px;

  display: grid;
  grid-template-columns: 1.2fr 1fr auto auto;
  align-items: center;
  gap: 20px;

  padding: 8px 18px;

  border: 1px solid rgba(255, 255, 255, 0.88);
  border-radius: 20px;

  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  box-shadow:
    var(--cos-shadow-soft),
    inset 0 1px 0 rgba(255, 255, 255, 0.92);
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: 8px;

  padding: 0;
  border: 0;
  background: transparent;

  text-align: start;
}

.footer-brand img {
  width: 34px;
  height: 34px;
  object-fit: contain;
}

.footer-brand span {
  display: flex;
  flex-direction: column;
}

.footer-brand strong {
  font-size: 9px;
  color: var(--cos-text);
}

.footer-brand b {
  margin-top: 2px;
  font-size: 10px;
  color: var(--cos-primary);
}

.footer-brand small {
  margin-top: 3px;
  color: #9096ad;
  font-size: 5px;
}

.footer-links {
  display: flex;
  justify-content: center;
  gap: 16px;
}

.footer-links button {
  padding: 4px;
  border: 0;
  background: transparent;

  color: #747c99;
  font-size: 7px;
  font-weight: 650;
}

.footer-social {
  display: flex;
  gap: 7px;
}

.footer-social span {
  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  border-radius: 8px;

  color: #646d8f;
  background: rgba(112, 72, 245, 0.06);

  font-size: 10px;
}

.footer-inner > p {
  margin: 0;
  color: #9a9fb3;
  font-size: 6px;
  white-space: nowrap;
}

/* =========================================================
   Modals
   ========================================================= */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 999;

  display: grid;
  place-items: center;

  padding: 20px;

  background: rgba(22, 25, 60, 0.42);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.booking-modal,
.success-modal,
.error-modal {
  position: relative;
  width: min(590px, 100%);
  max-height: min(760px, calc(100vh - 40px));

  overflow-y: auto;

  padding: 28px;

  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 24px;

  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 30px 80px rgba(32, 25, 83, 0.25);
}

.modal-close {
  position: absolute;
  top: 14px;
  right: 14px;

  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border: 0;
  border-radius: 10px;

  background: rgba(112, 72, 245, 0.07);
  color: #66708f;

  font-size: 21px;
}

.modal-heading {
  text-align: center;
  padding: 4px 30px 20px;
}

.modal-icon,
.success-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;

  margin: 0 auto 12px;

  border-radius: 16px;
  background: rgba(112, 72, 245, 0.09);
}

.modal-heading h2,
.success-modal h2,
.error-modal h2 {
  margin: 0;

  color: var(--cos-text);
  font-size: 23px;
  font-weight: 850;
}

.modal-heading p,
.success-modal p,
.error-modal p {
  margin: 8px auto 0;
  color: #7a829e;
  font-size: 10px;
  line-height: 1.65;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.form-grid label {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-grid label.full-field {
  grid-column: 1 / -1;
}

.form-grid label > span {
  color: #505a7e;
  font-size: 9px;
  font-weight: 750;
}

.form-grid input,
.form-grid select,
.form-grid textarea {
  width: 100%;

  border: 1px solid rgba(112, 72, 245, 0.12);
  border-radius: 11px;

  outline: none;

  background: rgba(248, 247, 255, 0.9);
  color: var(--cos-text);

  font-size: 10px;
}

.form-grid input,
.form-grid select {
  height: 42px;
  padding: 0 12px;
}

.form-grid textarea {
  min-height: 95px;
  padding: 11px 12px;
  resize: vertical;
}

.form-grid input:focus,
.form-grid select:focus,
.form-grid textarea:focus {
  border-color: rgba(112, 72, 245, 0.42);
  box-shadow: 0 0 0 3px rgba(112, 72, 245, 0.07);
}

.submit-booking-button {
  width: 100%;
  min-height: 46px;

  margin-top: 16px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  border: 0;
  border-radius: 12px;

  color: white;
  background: linear-gradient(100deg, #7548f5, #38aaff);

  font-size: 10px;
  font-weight: 800;

  box-shadow: 0 11px 26px rgba(100, 75, 220, 0.18);
}

.submit-booking-button:disabled {
  opacity: 0.65;
  cursor: wait;
}

.success-modal,
.error-modal {
  max-width: 430px;
  text-align: center;
}

.success-icon {
  color: #12b778;
  background: rgba(18, 183, 120, 0.1);
}

.error-icon {
  width: 52px;
  height: 52px;

  display: grid;
  place-items: center;

  margin: 0 auto 12px;

  border-radius: 50%;

  color: #d84c61;
  background: rgba(216, 76, 97, 0.1);

  font-size: 25px;
  font-weight: 850;
}

.success-actions,
.error-actions {
  display: flex;
  justify-content: center;
  gap: 8px;

  margin-top: 20px;
}

.success-actions a,
.success-actions button,
.error-actions a,
.error-actions button {
  min-height: 40px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;

  padding: 0 15px;

  border-radius: 10px;

  font-size: 9px;
  font-weight: 800;
}

.success-whatsapp,
.error-actions a {
  color: white;
  background: #16bd7c;
}

.success-actions button,
.error-actions button {
  border: 1px solid rgba(112, 72, 245, 0.15);
  background: transparent;
  color: #69728f;
}

/* =========================================================
   RTL
   ========================================================= */

html[dir="rtl"] .public-site {
  direction: rtl;
}

html[dir="ltr"] .public-site {
  direction: ltr;
}

html[dir="rtl"] .hero-copy,
html[dir="rtl"] .feature-card,
html[dir="rtl"] .pricing-card,
html[dir="rtl"] .tool-card,
html[dir="rtl"] .booking-modal,
html[dir="rtl"] .success-modal,
html[dir="rtl"] .error-modal {
  text-align: right;
}

html[dir="rtl"] .site-logo,
html[dir="rtl"] .footer-brand {
  text-align: right;
}

html[dir="rtl"] .popular-label {
  left: 12px;
  right: auto;
}

html[dir="rtl"] .floating-menu {
  left: 1%;
  right: auto;
}

html[dir="rtl"] .floating-students {
  left: 3%;
  right: auto;
}

html[dir="rtl"] .floating-chart {
  right: 2%;
  left: auto;
}

html[dir="rtl"] .mockup-sidebar {
  border-right: 0;
  border-left: 1px solid rgba(100, 77, 179, 0.07);
}

html[dir="rtl"] .mockup-main {
  transform: rotate(1.2deg);
}

/* Keep structural grid placement stable */
.hero-content,
.features-grid,
.pricing-grid,
.bottom-tools,
.footer-inner {
  direction: ltr;
}

.hero-copy,
.feature-card,
.pricing-card,
.tool-card,
.footer-brand {
  direction: inherit;
}

/* =========================================================
   Tablet
   ========================================================= */

@media (max-width: 1050px) {
  .site-header {
    width: min(960px, calc(100% - 36px));
  }

  .section-shell,
  .site-footer {
    width: min(960px, calc(100% - 36px));
  }

  .hero-section {
    padding-inline: 24px;
  }

  .hero-content {
    grid-template-columns: 45% 55%;
  }

  .hero-copy h1 {
    font-size: clamp(32px, 4.3vw, 46px);
  }

  .features-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .pricing-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .bottom-tools {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-inner {
    grid-template-columns: 1fr 1fr;
  }

  .footer-links {
    justify-content: flex-end;
  }

  .footer-social {
    justify-content: flex-start;
  }
}

/* =========================================================
   Mobile
   ========================================================= */

@media (max-width: 760px) {
  .public-site {
    padding-top: 9px;
  }

  .site-header {
    position: sticky;
    top: 8px;
    width: calc(100% - 22px);
  }

  .site-nav {
    min-height: 58px;
    padding: 7px 9px 7px 13px;
    border-radius: 18px;
  }

  .site-logo img {
    width: 38px;
    height: 38px;
    flex-basis: 38px;
  }

  .site-logo strong {
    font-size: 12px;
  }

  .site-logo b {
    font-size: 13px;
  }

  .main-nav {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;

    display: none;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;

    padding: 10px;

    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 17px;

    background: rgba(255, 255, 255, 0.93);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);

    box-shadow: 0 18px 45px rgba(67, 49, 145, 0.13);
  }

  .main-nav.open {
    display: flex;
  }

  .main-nav button {
    min-height: 43px;
    text-align: center;
  }

  .language-switcher {
    display: none;
  }

  .theme-button {
    display: none;
  }

  .header-call-button {
    min-height: 36px;
    padding-inline: 11px;
    font-size: 9px;
  }

  .mobile-menu-button {
    display: block;
  }

  .section-shell,
  .site-footer {
    width: calc(100% - 22px);
  }

  .hero-section {
    margin-top: 11px;
    padding: 31px 18px 18px;
    border-radius: 24px;
  }

  .hero-content {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .hero-copy {
    padding: 0 2px 12px;
    text-align: center;
  }

  .hero-badge {
    margin-inline: auto;
  }

  .hero-copy h1 {
    max-width: 100%;
    font-size: clamp(34px, 10vw, 48px);
    letter-spacing: -1.7px;
  }

  .hero-copy > p {
    max-width: 580px;
    margin-inline: auto;
    font-size: 10px;
  }

  .hero-benefits {
    justify-content: center;
    gap: 10px 14px;
  }

  .hero-visual {
    height: 300px;
    margin-top: 2px;
  }

  .mockup-main {
    width: 88%;
    right: 6%;
    top: 27px;
  }

  .floating-students {
    top: 4px;
    right: 0;
  }

  .floating-chart {
    top: 70px;
    left: 0;
  }

  .floating-menu {
    right: 0;
    bottom: 5px;
  }

  .floating-menu div {
    min-width: 88px;
  }

  .mockup-message {
    right: 18%;
    top: 89px;
  }

  .features-grid,
  .pricing-grid,
  .bottom-tools {
    grid-template-columns: 1fr;
  }

  .feature-card {
    min-height: 92px;
  }

  .packages-section {
    padding: 21px 15px;
    border-radius: 22px;
  }

  .section-heading {
    align-items: stretch;
    flex-direction: column;
  }

  .section-heading h2 {
    font-size: 25px;
  }

  .billing-switch {
    align-self: flex-start;
  }

  .pricing-card {
    min-height: 315px;
  }

  .bottom-tools {
    gap: 10px;
  }

  .tool-card {
    min-height: 115px;
  }

  .footer-inner {
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 11px;
    padding: 16px;
    text-align: center;
  }

  .footer-links {
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 15px;
  }

  .footer-social {
    justify-content: center;
  }

  .footer-inner > p {
    white-space: normal;
  }

  .booking-modal {
    padding: 22px 17px;
    border-radius: 20px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .form-grid label.full-field {
    grid-column: auto;
  }

  .success-actions,
  .error-actions {
    flex-direction: column;
  }

  .success-actions a,
  .success-actions button,
  .error-actions a,
  .error-actions button {
    width: 100%;
  }

  html[dir="rtl"] .hero-copy {
    text-align: center;
  }
}

/* =========================================================
   Small Phones
   ========================================================= */

@media (max-width: 430px) {
  .site-logo span {
    display: none;
  }

  .header-call-button {
    padding-inline: 9px;
  }

  .hero-section {
    padding-inline: 13px;
  }

  .hero-copy h1 {
    font-size: 34px;
  }

  .hero-copy > p {
    font-size: 9px;
  }

  .hero-visual {
    height: 265px;
  }

  .mockup-main {
    width: 94%;
    right: 3%;
  }

  .mockup-body {
    grid-template-columns: 72px 1fr;
  }

  .mock-nav span {
    display: none;
  }

  .mock-nav {
    justify-content: center;
  }

  .floating-menu div {
    min-width: 76px;
    padding-inline: 7px;
  }

  .floating-menu div span {
    font-size: 5px;
  }

  .floating-students {
    transform: scale(0.88);
    transform-origin: top right;
  }

  .floating-chart {
    transform: scale(0.84);
    transform-origin: top left;
  }

  .mockup-message {
    display: none;
  }

  .pricing-price strong {
    font-size: 23px;
  }

  .modal-heading h2 {
    font-size: 20px;
  }
}

/* =========================================================
   Reduced Motion
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
