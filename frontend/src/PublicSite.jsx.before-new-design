function Countdown({ t }) {
  const launchDate = useMemo(
    () => new Date("2026-12-04T00:00:00+03:00"),
    []
  );

  const [time, setTime] = useState({
    days: 0,
    hours: 0,
    minutes: 0,
    seconds: 0,
  });

  useEffect(() => {
    const update = () => {
      const diff = Math.max(0, launchDate.getTime() - Date.now());
      const totalSeconds = Math.floor(diff / 1000);

      setTime({
        days: Math.floor(totalSeconds / 86400),
        hours: Math.floor((totalSeconds % 86400) / 3600),
        minutes: Math.floor((totalSeconds % 3600) / 60),
        seconds: totalSeconds % 60,
      });
    };

    update();
    const timer = setInterval(update, 1000);
    return () => clearInterval(timer);
  }, [launchDate]);

  return (
    <div className="countdown">
      <div>
        <strong>{String(time.days).padStart(2, "0")}</strong>
        <span>{t.days}</span>
      </div>
      <div>
        <strong>{String(time.hours).padStart(2, "0")}</strong>
        <span>{t.hours}</span>
      </div>
      <div>
        <strong>{String(time.minutes).padStart(2, "0")}</strong>
        <span>{t.minutes}</span>
      </div>
      <div>
        <strong>{String(time.seconds).padStart(2, "0")}</strong>
        <span>{t.seconds}</span>
      </div>
    </div>
  );
}

