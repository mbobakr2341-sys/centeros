                    </option>
                    <option value="1">1</option>
                    <option value="2-3">2 - 3</option>
                    <option value="4-5">4 - 5</option>
                    <option value="6+">6+</option>
                  </select>
                </label>
              </div>

              <label>
                <span>{t.studentsCount}</span>
                <select
                  required
                  value={form.studentsCount}
                  onChange={(e) =>
                    updateForm("studentsCount", e.target.value)
                  }
                >
                  <option value="" disabled>
                    —
                  </option>
                  <option value="حتى 100 طالب">حتى 100 طالب</option>
                  <option value="حتى 200 طالب">حتى 200 طالب</option>
                  <option value="حتى 300 طالب">حتى 300 طالب</option>
                  <option value="حتى 400 طالب">حتى 400 طالب</option>
                  <option value="حتى 500 طالب">حتى 500 طالب</option>
                  <option value="أكثر من 500 طالب">
                    أكثر من 500 طالب
                  </option>
                </select>
              </label>

              <label>
                <span>{t.additionalInfo}</span>
                <textarea
                  rows="4"
                  value={form.additionalInfo}
                  onChange={(e) =>
                    updateForm("additionalInfo", e.target.value)
                  }
                />
              </label>

              <button className="submit-button" disabled={sending}>
                {sending ? t.sending : t.sendRequest}
                {!sending && <span>→</span>}
              </button>
            </form>
          </div>
        </section>
      </main>

      <footer className="public-footer">
        <div className="footer-inner">
          <div className="footer-brand">
            <img src="/newlogo.png" alt="CenterOS" />
            <div>
              <strong>CenterOS</strong>
              <p>{t.footerText}</p>
            </div>
          </div>

          <div className="footer-links">
            <button onClick={() => scrollTo("home")}>{t.navHome}</button>
            <button onClick={() => scrollTo("features")}>
              {t.navFeatures}
            </button>
            <button onClick={() => scrollTo("packages")}>
              {t.navPackages}
            </button>
            <button onClick={() => scrollTo("contact")}>
              {t.navContact}
            </button>
          </div>

          <div className="footer-copy">
            © {new Date().getFullYear()} CenterOS. All rights reserved.
          </div>
        </div>
      </footer>

      {success && (
        <div className="success-overlay">
          <div className="success-modal">
            <button
              className="modal-close"
              onClick={() => setSuccess(false)}
            >
              ×
            </button>

            <div className="success-check">✓</div>
            <h3>{t.success}</h3>
            <p>{t.successText}</p>

            <a
              className="whatsapp-button"
              href="https://wa.me/201109330703"
              target="_blank"
              rel="noreferrer"
            >
              {t.whatsapp}
            </a>
          </div>
        </div>
      )}
    </div>
  );
}
