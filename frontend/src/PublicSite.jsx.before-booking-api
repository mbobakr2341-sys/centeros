          stroke="currentColor"
          strokeWidth="1.4"
        />
      </svg>
    );
  }

  if (type === "calendar") {
    return (
      <svg {...common}>
        <rect
          x="4"
          y="5"
          width="16"
          height="15"
          rx="2.5"
          stroke="currentColor"
          strokeWidth="1.6"
        />
        <path
          d="M8 3.5V7M16 3.5V7M4 9.5H20"
          stroke="currentColor"
          strokeWidth="1.6"
          strokeLinecap="round"
