          fill="currentColor"
        />
      </svg>
    );
  }

  if (type === "chart") {
    return (
      <svg {...common}>
        <path
          d="M4 19V5M4 19H21"
          stroke="currentColor"
          strokeWidth="1.7"
          strokeLinecap="round"
        />
        <path
          d="M7 15L10 11L13 13L18 7"
          stroke="currentColor"
          strokeWidth="1.8"
          strokeLinecap="round"
          strokeLinejoin="round"
        />
      </svg>
    );
  }

  if (type === "users") {
    return (
      <svg {...common}>
        <circle
          cx="9"
          cy="8"
          r="3"
          stroke="currentColor"
          strokeWidth="1.7"
        />
        <circle
          cx="17"
          cy="9"
          r="2.5"
          stroke="currentColor"
          strokeWidth="1.7"
        />
        <path
          d="M3.5 19C3.8 15.5 6 13.5 9 13.5C12 13.5 14.2 15.5 14.5 19"
          stroke="currentColor"
          strokeWidth="1.7"
          strokeLinecap="round"
        />
        <path
          d="M14.5 14C17.4 13.5 20 15.1 20.5 18.5"
          stroke="currentColor"
          strokeWidth="1.7"
          strokeLinecap="round"
        />
      </svg>
    );
  }

  if (type === "globe") {
    return (
