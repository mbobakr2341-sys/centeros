:root {
  --site-bg: #f7f8ff;
  --white: #ffffff;
  --text: #172052;
  --muted: #68708d;
  --line: #e5e8f5;
  --purple: #6846ee;
  --purple-dark: #5133d6;
  --blue: #4388f5;
  --green: #19b980;
  --soft-purple: #f0edff;
  --soft-blue: #edf4ff;
  --shadow: 0 18px 55px rgba(53, 46, 125, 0.09);
  --shadow-soft: 0 8px 30px rgba(53, 46, 125, 0.06);
  --radius: 22px;
  --container: 1180px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--site-bg);
}

body {
  margin: 0;
  min-width: 320px;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  color: var(--text);
  background: var(--site-bg);
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

.public-site {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 10% 18%, rgba(113, 83, 255, 0.08), transparent 27%),
    radial-gradient(circle at 90% 15%, rgba(67, 136, 245, 0.09), transparent 28%),
    var(--site-bg);
}

.site-background {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.background-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.28;
}

.orb-one {
  width: 360px;
  height: 360px;
  top: 8%;
  left: -160px;
  background: #cfc4ff;
}

.orb-two {
  width: 320px;
  height: 320px;
  right: -130px;
  top: 35%;
  background: #c9ddff;
}

.orb-three {
  width: 280px;
  height: 280px;
  bottom: 5%;
  left: 35%;
  background: #ddd4ff;
}

/* =========================================
   LAUNCH BAR
========================================= */

.launch-bar {
  position: relative;
  z-index: 20;
  width: 100%;
  padding: 10px 20px;
  background: #f0efff;
  border-bottom: 1px solid #e3e1f7;
}

.launch-inner {
  width: min(var(--container), 100%);
  margin: auto;
  min-height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 46px;
}

.launch-label {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #555d7d;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.launch-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--purple);
  box-shadow: 0 0 0 5px rgba(104, 70, 238, 0.1);
}

.countdown {
  display: flex;
  align-items: center;
  gap: 18px;
}

.countdown > div {
  display: flex;
  align-items: baseline;
  gap: 5px;
}

.countdown strong {
  color: var(--text);
  font-size: 18px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -0.5px;
}

.countdown span {
  color: #858ba3;
  font-size: 9px;
  font-weight: 600;
}

.countdown i {
  color: #a5a8bd;
  font-style: normal;
  font-weight: 700;
}

/* =========================================
   HEADER
========================================= */

.site-header {
  position: relative;
  z-index: 30;
  padding: 15px 20px;
}

.site-header-inner {
  width: min(var(--container), 100%);
  min-height: 70px;
  margin: auto;
  padding: 10px 14px 10px 20px;
  display: flex;
  align-items: center;
  gap: 28px;
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid rgba(225, 227, 240, 0.9);
  border-radius: 20px;
  box-shadow: var(--shadow-soft);
}

.brand,
.footer-brand {
  border: 0;
  padding: 0;
  background: transparent;
}

.brand {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.brand img {
  width: 154px;
  height: auto;
  display: block;
}

.main-nav {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
}

.main-nav button {
  position: relative;
  border: 0;
  background: transparent;
  color: #616983;
  padding: 11px 17px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 650;
  transition: color 0.2s ease, background 0.2s ease;
}

.main-nav button:hover,
.main-nav button.active {
  color: var(--purple);
  background: #f3f0ff;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.language-menu {
  position: relative;
}

.language-circle {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 50%;
  color: #4d5675;
  background: #fff;
  transition: 0.2s ease;
}

.language-circle:hover {
  color: var(--purple);
  border-color: #d6cdfd;
  background: var(--soft-purple);
}

.language-dropdown {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  width: 145px;
  padding: 7px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 15px;
  box-shadow: var(--shadow);
}

.language-dropdown button {
  width: 100%;
  border: 0;
  border-radius: 9px;
  background: transparent;
  padding: 10px 11px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #5f6782;
  font-size: 12px;
}

.language-dropdown button:hover,
.language-dropdown button.selected {
  background: var(--soft-purple);
  color: var(--purple);
}

.header-book,
.primary-button {
  border: 0;
  color: white;
  background: linear-gradient(100deg, var(--purple-dark), #7652ef 58%, var(--blue));
  box-shadow: 0 9px 22px rgba(104, 70, 238, 0.2);
}

.header-book {
  min-height: 40px;
  padding: 0 17px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 750;
}

.mobile-menu {
  display: none;
  width: 40px;
  height: 40px;
  border: 1px solid var(--line);
  background: white;
  border-radius: 11px;
  color: var(--text);
}

/* =========================================
   GENERAL
========================================= */

.hero,
.features-section,
.home-packages,
.inner-page,
.site-footer {
  position: relative;
  z-index: 2;
}

.hero {
  width: min(var(--container), calc(100% - 40px));
  min-height: 570px;
  margin: 5px auto 0;
  padding: 68px 58px 62px;
  overflow: hidden;
  border-radius: 30px;
  background:
    radial-gradient(circle at 82% 32%, rgba(125, 98, 255, 0.17), transparent 33%),
    linear-gradient(115deg, #ffffff 0%, #fbfaff 48%, #f0f5ff 100%);
  border: 1px solid #e4e7f4;
  box-shadow: var(--shadow);
}

.hero-background-shape {
  position: absolute;
  pointer-events: none;
  border-radius: 50%;
}

.shape-one {
  width: 500px;
  height: 500px;
  right: -190px;
  top: -180px;
  border: 1px solid rgba(104, 70, 238, 0.09);
}

.shape-two {
  width: 360px;
  height: 360px;
  right: 60px;
  bottom: -220px;
  background: rgba(95, 142, 247, 0.07);
}

.hero-inner {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 0.88fr 1.12fr;
  align-items: center;
  gap: 55px;
  direction: ltr;
}

.hero-copy {
  direction: rtl;
  text-align: left;
}

html[dir="rtl"] .hero-copy {
  text-align: right;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--purple);
  background: var(--soft-purple);
  border: 1px solid #e5defd;
  border-radius: 999px;
  padding: 7px 12px;
  font-size: 11px;
  font-weight: 750;
}

.eyebrow-mark {
  display: inline-flex;
}

.hero h1 {
  margin: 20px 0 19px;
  color: var(--text);
  font-size: clamp(42px, 4.2vw, 62px);
  line-height: 1.04;
  letter-spacing: -2.8px;
  font-weight: 850;
}

.hero h1 span {
  background: linear-gradient(95deg, var(--purple-dark), #7250ef 55%, var(--blue));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-copy > p {
  max-width: 580px;
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.9;
}

.hero-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 13px;
  margin-top: 25px;
}

.hero-benefits span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #59627d;
  font-size: 11px;
  font-weight: 650;
}

.hero-benefits svg {
  color: var(--purple);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 11px;
  margin-top: 29px;
}

.primary-button,
.secondary-button {
  min-height: 47px;
  padding: 0 21px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  font-size: 12px;
  font-weight: 750;
  transition: 0.2s ease;
}

.primary-button:hover {
  box-shadow: 0 13px 28px rgba(104, 70, 238, 0.27);
}

.secondary-button {
  border: 1px solid #d9dcef;
  color: #505976;
  background: #fff;
}

.secondary-button:hover {
  color: var(--purple);
  border-color: #c9c0fa;
  background: #fbfaff;
}

.hero-visual {
  min-width: 0;
}

/* =========================================
   DASHBOARD PREVIEW
========================================= */

.dashboard-preview {
  position: relative;
  min-height: 390px;
  padding: 30px 10px 15px;
}

.preview-glow {
  position: absolute;
  width: 75%;
  height: 70%;
  right: 5%;
  top: 10%;
  background: rgba(103, 73, 238, 0.12);
  filter: blur(70px);
  border-radius: 50%;
}

.preview-window {
  position: relative;
  z-index: 2;
  width: 100%;
  border: 8px solid rgba(255, 255, 255, 0.95);
  border-radius: 19px;
  background: #fff;
  overflow: hidden;
  box-shadow:
    0 25px 55px rgba(45, 42, 105, 0.16),
    0 0 0 1px rgba(210, 211, 229, 0.8);
  transform: perspective(1200px) rotateY(-2deg) rotateX(1deg);
}

.preview-top {
  height: 42px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fafaff;
  border-bottom: 1px solid #ececf5;
}

.preview-logo img {
  width: 90px;
  display: block;
}

.preview-top-lines {
  display: flex;
  gap: 5px;
}

.preview-top-lines span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #d9d9ea;
}

.preview-layout {
  min-height: 315px;
  display: grid;
  grid-template-columns: 105px 1fr;
}

.preview-layout aside {
  padding: 18px 12px;
  background: #f8f8fd;
  border-right: 1px solid #ededf5;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.preview-layout aside span {
  height: 10px;
  border-radius: 5px;
  background: #dedfed;
}

.preview-layout aside span:nth-child(2) {
  width: 70%;
}

.preview-layout aside span:nth-child(3) {
  width: 88%;
}

.preview-layout aside span:nth-child(4) {
  width: 62%;
}

.preview-layout aside span:nth-child(5) {
  width: 78%;
}

.preview-layout aside span:nth-child(6) {
  width: 54%;
}

.preview-layout aside .preview-active {
  height: 31px;
  width: 100%;
  border-radius: 8px;
  background: #ece7ff;
}

.preview-content {
  padding: 20px;
  background: #fff;
}

.preview-heading {
  display: flex;
  justify-content: space-between;
  gap: 20px;
}

.preview-heading span {
  display: block;
  height: 12px;
  border-radius: 6px;
  background: #dcddeb;
}

.preview-heading span:first-child {
  width: 130px;
}

.preview-heading span:last-child {
  width: 75px;
}

.preview-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 18px;
}

.preview-stats > div {
  padding: 13px;
  border: 1px solid #e7e8f1;
  border-radius: 10px;
}

.preview-stats b {
  display: block;
  color: var(--text);
  font-size: 17px;
}

.preview-stats small {
  color: #8a8fa5;
  font-size: 8px;
}

.preview-main-grid {
  display: grid;
  grid-template-columns: 1.55fr 0.65fr;
  gap: 11px;
  margin-top: 11px;
}

.preview-chart,
.preview-side {
  border: 1px solid #e8e9f2;
  border-radius: 10px;
  min-height: 155px;
  padding: 12px;
}

.chart-lines {
  display: flex;
  flex-direction: column;
  gap: 21px;
}

.chart-lines span {
  height: 1px;
  width: 100%;
  background: #ececf4;
}

.preview-chart svg {
  width: 100%;
  height: 80px;
  margin-top: -68px;
  overflow: visible;
}

.preview-chart path {
  fill: none;
  stroke: #7451ef;
  stroke-width: 4;
}

.preview-side {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.preview-side span {
  height: 34px;
  border-radius: 7px;
  background: #f0edff;
}

.floating-card {
  position: absolute;
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 11px 14px;
  background: #fff;
  border: 1px solid #e5e4f1;
  border-radius: 13px;
  box-shadow: var(--shadow-soft);
}

.floating-one {
  left: -12px;
  top: 18px;
}

.floating-two {
  right: -9px;
  bottom: 30px;
}

.mini-icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  color: var(--purple);
  background: var(--soft-purple);
  border-radius: 9px;
}

.floating-card strong {
  display: block;
  color: var(--text);
  font-size: 13px;
}

.floating-card small {
  display: block;
  color: #8a8fa4;
  font-size: 8px;
  margin-top: 2px;
}

/* =========================================
   FEATURES
========================================= */

.features-section,
.home-packages {
  width: min(var(--container), calc(100% - 40px));
  margin: 35px auto 0;
}

.section-heading {
  margin-bottom: 23px;
}

.section-heading > span,
.section-heading > div > span {
  display: block;
  color: var(--text);
  font-size: 27px;
  line-height: 1.2;
  font-weight: 820;
  letter-spacing: -0.8px;
}

.section-heading p {
  max-width: 650px;
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.8;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.feature-card {
  min-height: 170px;
  padding: 25px 22px;
  display: flex;
  flex-direction: column;
  gap: 19px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
}

.feature-icon {
  width: 47px;
  height: 47px;
  display: grid;
  place-items: center;
  color: var(--purple);
  background: var(--soft-purple);
  border-radius: 14px;
}

.feature-card h3 {
  margin: 0 0 7px;
  color: var(--text);
  font-size: 15px;
  font-weight: 780;
}

.feature-card p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.7;
}

/* =========================================
   HOME PACKAGES
========================================= */

.home-packages {
  padding: 38px 0 65px;
}

.section-heading-row {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
}

.text-button {
  border: 0;
  background: transparent;
  color: var(--purple);
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  font-weight: 750;
}

.home-package-preview {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.small-plan {
  position: relative;
  min-height: 200px;
  padding: 23px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
}

.small-plan.popular {
  border-color: #bfb1fb;
}

.popular-label {
  position: absolute;
  top: -10px;
  right: 20px;
  padding: 5px 10px;
  border-radius: 999px;
  color: white;
  background: var(--purple);
  font-size: 9px;
  font-weight: 750;
}

.small-plan h3 {
  margin: 0;
  color: var(--text);
  font-size: 16px;
}

.small-plan p {
  min-height: 32px;
  margin: 7px 0 22px;
  color: var(--muted);
  font-size: 10px;
}

.small-plan strong {
  color: var(--text);
  font-size: 28px;
}

.small-plan small {
  color: #858ba3;
  font-size: 10px;
  margin-left: 4px;
}

/* =========================================
   INNER PAGES
========================================= */

.inner-page {
  width: min(var(--container), calc(100% - 40px));
  min-height: 690px;
  margin: 12px auto 0;
  padding-bottom: 75px;
}

.page-hero {
  position: relative;
  overflow: hidden;
  padding: 65px 60px 58px;
  border: 1px solid var(--line);
  border-radius: 28px;
  background:
    radial-gradient(circle at 85% 35%, rgba(112, 80, 241, 0.11), transparent 30%),
    #fff;
  box-shadow: var(--shadow-soft);
}

.page-hero h1 {
  max-width: 820px;
  margin: 18px 0 14px;
  color: var(--text);
  font-size: clamp(38px, 4vw, 55px);
  line-height: 1.08;
  letter-spacing: -2px;
}

.page-hero p {
  max-width: 720px;
  margin: 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.9;
}

.billing-switch {
  width: fit-content;
  margin-top: 30px;
  padding: 5px;
  display: flex;
  align-items: center;
  gap: 4px;
  background: #f3f2fa;
  border: 1px solid #e7e5ef;
  border-radius: 13px;
}

.billing-switch button {
  min-width: 100px;
  min-height: 38px;
  padding: 0 12px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #747b95;
  font-size: 11px;
  font-weight: 700;
}

.billing-switch button.active {
  color: #fff;
  background: var(--purple);
  box-shadow: 0 5px 15px rgba(104, 70, 238, 0.2);
}

.billing-switch em {
  margin-left: 6px;
  color: #1ab57d;
  font-size: 8px;
  font-style: normal;
}

/* =========================================
   PRICING
========================================= */

.pricing-section {
  margin-top: 25px;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 17px;
  align-items: stretch;
}

.pricing-card {
  position: relative;
  padding: 29px 25px 25px;
  display: flex;
  flex-direction: column;
  min-height: 480px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 23px;
  box-shadow: var(--shadow-soft);
}

.pricing-card.featured {
  border: 1.5px solid #a897f5;
  box-shadow: 0 18px 50px rgba(104, 70, 238, 0.13);
}

.popular-badge {
  position: absolute;
  top: -11px;
  right: 19px;
  padding: 6px 11px;
  border-radius: 999px;
  color: white;
  background: linear-gradient(100deg, var(--purple-dark), var(--blue));
  font-size: 9px;
  font-weight: 750;
}

.pricing-icon,
.about-panel-icon,
.contact-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  color: var(--purple);
  background: var(--soft-purple);
  border-radius: 14px;
}

.pricing-card h2 {
  margin: 19px 0 6px;
  color: var(--text);
  font-size: 20px;
}

.pricing-card > p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  min-height: 32px;
}

.price {
  margin-top: 25px;
  color: var(--text);
  font-size: 31px;
  font-weight: 850;
  letter-spacing: -1px;
}

.price small {
  margin-left: 5px;
  color: #888da4;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0;
}

.plan-divider {
  height: 1px;
  margin: 22px 0 17px;
  background: #e9eaf2;
}

.pricing-card ul {
  flex: 1;
  margin: 0 0 25px;
  padding: 0;
  list-style: none;
}

.pricing-card li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 11px;
  color: #68708b;
  font-size: 10px;
  line-height: 1.5;
}

.pricing-card li svg {
  flex-shrink: 0;
  color: var(--green);
  margin-top: 1px;
}

.full {
  width: 100%;
}

/* =========================================
   ABOUT
========================================= */

.about-layout {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
  margin-top: 25px;
}

.about-panel {
  padding: 31px 28px;
  min-height: 230px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 23px;
  box-shadow: var(--shadow-soft);
}

.about-panel h2 {
  margin: 20px 0 9px;
  color: var(--text);
  font-size: 18px;
}

.about-panel p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.8;
}

.cta-section {
  margin-top: 24px;
  padding: 35px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  border-radius: 22px;
  background: linear-gradient(100deg, #6340e6, #7352ef 50%, #468df3);
  color: #fff;
}

.cta-section .eyebrow {
  color: #fff;
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.17);
}

.cta-section h2 {
  margin: 14px 0 7px;
  font-size: 24px;
}

.cta-section p {
  margin: 0;
  max-width: 620px;
  color: rgba(255, 255, 255, 0.82);
  font-size: 12px;
  line-height: 1.7;
}

.cta-section .primary-button {
  flex-shrink: 0;
  color: var(--purple);
  background: #fff;
  box-shadow: none;
}

/* =========================================
   CONTACT
========================================= */

.contact-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
  margin-top: 25px;
}

.contact-card {
  min-height: 220px;
  padding: 28px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 23px;
  box-shadow: var(--shadow-soft);
}

.contact-card > span {
  margin-top: 20px;
  color: #858ba3;
  font-size: 10px;
  font-weight: 650;
}

.contact-card a,
.contact-card button {
  margin-top: 8px;
  border: 0;
  background: transparent;
  padding: 0;
  color: var(--text);
  font-size: 14px;
  font-weight: 780;
  text-align: left;
}

.contact-card a:hover,
.contact-card button:hover {
  color: var(--purple);
}

.whatsapp-card .contact-icon {
  color: #16a979;
  background: #e9fbf4;
}

/* =========================================
   BOOKING
========================================= */

.booking-layout {
  display: grid;
  grid-template-columns: 0.7fr 1.3fr;
  gap: 20px;
  margin-top: 25px;
  align-items: start;
}

.booking-info {
  display: grid;
  gap: 16px;
}

.booking-info-card {
  padding: 28px;
  min-height: 185px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 22px;
  box-shadow: var(--shadow-soft);
}

.booking-info-card h2 {
  margin: 18px 0 7px;
  color: var(--text);
  font-size: 17px;
}

.booking-info-card p {
  margin: 0 0 10px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.8;
}

.booking-info-card a {
  color: var(--purple);
  font-size: 12px;
  font-weight: 700;
}

.booking-form {
  padding: 32px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 23px;
  box-shadow: var(--shadow-soft);
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.booking-form label {
  display: block;
  margin-bottom: 18px;
  color: #4f5874;
  font-size: 11px;
  font-weight: 700;
}

.booking-form input,
.booking-form select,
.booking-form textarea {
  width: 100%;
  margin-top: 8px;
  padding: 13px 14px;
  border: 1px solid #dfe2ed;
  border-radius: 11px;
  outline: none;
  color: var(--text);
  background: #fbfbfd;
  font-size: 12px;
  transition: 0.2s ease;
}

.booking-form input:focus,
.booking-form select:focus,
.booking-form textarea:focus {
  border-color: #aa9af4;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(104, 70, 238, 0.07);
}

.booking-form textarea {
  min-height: 125px;
  resize: vertical;
}

.honeypot {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  opacity: 0 !important;
  pointer-events: none !important;
}

.submit-button {
  margin-top: 5px;
}

.form-error {
  margin-top: 13px;
  padding: 12px 14px;
  border: 1px solid #f0cccc;
  border-radius: 10px;
  color: #a13d3d;
  background: #fff6f6;
  font-size: 11px;
}

/* =========================================
   MODAL
========================================= */

.modal-backdrop {
  position: fixed;
  z-index: 100;
  inset: 0;
  padding: 20px;
  display: grid;
  place-items: center;
  background: rgba(25, 28, 54, 0.42);
}

.success-modal {
  width: min(430px, 100%);
  padding: 40px;
  text-align: center;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 24px;
  box-shadow: 0 30px 80px rgba(20, 23, 55, 0.25);
}

.success-mark {
  width: 64px;
  height: 64px;
  margin: 0 auto;
  display: grid;
  place-items: center;
  color: var(--green);
  background: #e9fbf4;
  border-radius: 50%;
}

.success-modal h2 {
  margin: 22px 0 9px;
  color: var(--text);
  font-size: 22px;
}

.success-modal p {
  margin: 0 0 25px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

/* =========================================
   FOOTER
========================================= */

.site-footer {
  width: min(var(--container), calc(100% - 40px));
  margin: 0 auto 24px;
}

.footer-inner {
  min-height: 85px;
  padding: 15px 22px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 25px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 19px;
  box-shadow: var(--shadow-soft);
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: 11px;
  text-align: left;
}

.footer-brand img {
  width: 115px;
  display: block;
}

.footer-brand span {
  color: #8990a8;
  font-size: 8px;
}

.footer-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 21px;
}

.footer-links button {
  border: 0;
  padding: 5px;
  background: transparent;
  color: #747b94;
  font-size: 10px;
}

.footer-links button:hover {
  color: var(--purple);
}

.footer-copy {
  justify-self: end;
  color: #969bae;
  font-size: 8px;
}

/* =========================================
   RESPONSIVE — TABLET
========================================= */

@media (max-width: 1050px) {
  .hero {
    padding: 55px 38px;
  }

  .hero-inner {
    gap: 35px;
  }

  .hero h1 {
    font-size: 45px;
  }

  .features-grid,
  .home-package-preview,
  .pricing-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .pricing-card {
    min-height: 450px;
  }
}

/* =========================================
   RESPONSIVE — SMALL TABLET
========================================= */

@media (max-width: 820px) {
  .site-header-inner {
    padding: 10px 13px;
  }

  .main-nav {
    display: none;
  }

  .main-nav.open {
    position: absolute;
    top: calc(100% + 5px);
    left: 20px;
    right: 20px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow);
  }

  .main-nav.open button {
    text-align: center;
  }

  .mobile-menu {
    display: grid;
    place-items: center;
  }

  .header-book span {
    display: none;
  }

  .header-book {
    width: 40px;
    padding: 0;
  }

  .hero-inner {
    grid-template-columns: 1fr;
  }

  .hero-copy {
    max-width: 720px;
  }

  .hero-visual {
    max-width: 720px;
    width: 100%;
    margin: auto;
  }

  .booking-layout {
    grid-template-columns: 1fr;
  }

  .contact-grid,
  .about-layout {
    grid-template-columns: 1fr;
  }

  .footer-inner {
    grid-template-columns: 1fr;
    text-align: center;
    justify-items: center;
  }

  .footer-brand {
    justify-content: center;
  }

  .footer-copy {
    justify-self: center;
  }
}

/* =========================================
   RESPONSIVE — MOBILE
========================================= */

@media (max-width: 600px) {
  .launch-bar {
    padding: 9px 12px;
  }

  .launch-inner {
    gap: 12px;
    justify-content: space-between;
  }

  .launch-label {
    font-size: 9px;
  }

  .countdown {
    gap: 7px;
  }

  .countdown strong {
    font-size: 12px;
  }

  .countdown span {
    display: none;
  }

  .countdown i {
    font-size: 10px;
  }

  .site-header {
    padding: 10px 12px;
  }

  .site-header-inner {
    min-height: 61px;
    padding: 8px 10px 8px 13px;
    border-radius: 16px;
  }

  .brand img {
    width: 124px;
  }

  .header-actions {
    gap: 7px;
  }

  .language-circle,
  .mobile-menu,
  .header-book {
    width: 36px;
    height: 36px;
  }

  .hero,
  .features-section,
  .home-packages,
  .inner-page,
  .site-footer {
    width: min(100% - 24px, var(--container));
  }

  .hero {
    min-height: 0;
    margin-top: 5px;
    padding: 38px 22px 30px;
    border-radius: 22px;
  }

  .hero-inner {
    gap: 15px;
  }

  .hero h1 {
    margin-top: 16px;
    font-size: 37px;
    letter-spacing: -1.7px;
    line-height: 1.08;
  }

  .hero-copy > p {
    font-size: 12px;
    line-height: 1.8;
  }

  .hero-benefits {
    gap: 9px;
  }

  .hero-benefits span {
    font-size: 9px;
  }

  .hero-actions {
    margin-top: 22px;
  }

  .primary-button,
  .secondary-button {
    min-height: 44px;
    padding: 0 16px;
    font-size: 10px;
  }

  .dashboard-preview {
    min-height: 270px;
    padding-top: 20px;
  }

  .preview-layout {
    min-height: 230px;
    grid-template-columns: 65px 1fr;
  }

  .preview-layout aside {
    padding: 12px 8px;
  }

  .preview-content {
    padding: 12px;
  }

  .preview-stats {
    gap: 5px;
  }

  .preview-stats > div {
    padding: 8px;
  }

  .preview-stats b {
    font-size: 12px;
  }

  .preview-main-grid {
    grid-template-columns: 1fr;
  }

  .preview-side {
    display: none;
  }

  .floating-card {
    padding: 7px 9px;
  }

  .floating-one {
    left: -4px;
  }

  .floating-two {
    right: -4px;
    bottom: 16px;
  }

  .mini-icon {
    width: 26px;
    height: 26px;
  }

  .floating-card strong {
    font-size: 10px;
  }

  .features-section,
  .home-packages {
    margin-top: 27px;
  }

  .section-heading > span,
  .section-heading > div > span {
    font-size: 22px;
  }

  .section-heading p {
    font-size: 11px;
  }

  .features-grid,
  .home-package-preview,
  .pricing-grid {
    grid-template-columns: 1fr;
  }

  .feature-card {
    min-height: 145px;
    padding: 21px;
  }

  .home-packages {
    padding-bottom: 40px;
  }

  .section-heading-row {
    align-items: flex-start;
    flex-direction: column;
  }

  .inner-page {
    margin-top: 7px;
  }

  .page-hero {
    padding: 40px 23px;
    border-radius: 21px;
  }

  .page-hero h1 {
    font-size: 34px;
    letter-spacing: -1.3px;
  }

  .page-hero p {
    font-size: 12px;
  }

  .billing-switch {
    width: 100%;
  }

  .billing-switch button {
    flex: 1;
    min-width: 0;
  }

  .pricing-card {
    min-height: 0;
    padding: 26px 22px 22px;
  }

  .about-panel,
  .contact-card {
    min-height: 0;
  }

  .cta-section {
    flex-direction: column;
    align-items: flex-start;
    padding: 27px 22px;
  }

  .cta-section h2 {
    font-size: 20px;
  }

  .booking-form {
    padding: 22px 17px;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .booking-info-card {
    padding: 23px;
  }

  .footer-inner {
    padding: 20px 15px;
  }

  .footer-links {
    flex-wrap: wrap;
    gap: 12px;
  }
}

/* =========================================
   RTL
========================================= */

html[dir="rtl"] .hero-inner,
html[dir="rtl"] .preview-layout,
html[dir="rtl"] .booking-layout {
  direction: rtl;
}

html[dir="rtl"] .hero-copy {
  text-align: right;
}

html[dir="rtl"] .preview-layout aside {
  border-right: 0;
  border-left: 1px solid #ededf5;
}

html[dir="rtl"] .floating-one {
  left: auto;
  right: -12px;
}

html[dir="rtl"] .floating-two {
  right: auto;
  left: -9px;
}

html[dir="rtl"] .language-dropdown {
  right: auto;
  left: 0;
}

html[dir="rtl"] .footer-brand {
  text-align: right;
}

html[dir="rtl"] .price small {
  margin-left: 0;
  margin-right: 5px;
}

/* =========================================
   ACCESSIBILITY
========================================= */

button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
a:focus-visible {
  outline: 3px solid rgba(104, 70, 238, 0.22);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition: none !important;
  }

  .preview-window {
    transform: none;
  }
}
