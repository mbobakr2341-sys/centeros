function LanguageSelector({ language, setLanguage }) {
  const [open, setOpen] = useState(false)
  const ref = useRef(null)

  const languages = [
    { code: 'en', short: 'EN', label: 'English' },
    { code: 'tr', short: 'TR', label: 'Türkçe' },
    { code: 'ar', short: 'AR', label: 'العربية' },
  ]

  const current =
    languages.find((item) => item.code === language) ||
    languages[0]

  useEffect(() => {
    const handleClick = (event) => {
      if (ref.current && !ref.current.contains(event.target)) {
        setOpen(false)
      }
    }

    document.addEventListener('mousedown', handleClick)

    return () => {
      document.removeEventListener('mousedown', handleClick)
    }
  }, [])

  return (
    <div className="language-selector" ref={ref}>
      <button
        type="button"
        className={`language-trigger ${open ? 'is-open' : ''}`}
        onClick={() => setOpen((value) => !value)}
        aria-expanded={open}
      >
        <span className="language-trigger-icon">
          <Icon name="globe" size={17} />
        </span>

        <span>{current.short}</span>

        <span className="language-chevron">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </span>
      </button>

      {open && (
        <div className="language-menu">
          <div className="language-menu-header">
            Language
          </div>

          {languages.map((item) => (
            <button
              type="button"
              key={item.code}
              className={`language-option ${
                language === item.code ? 'selected' : ''
              }`}
              onClick={() => {
                setLanguage(item.code)
                setOpen(false)
              }}
            >
              <span className="language-code">
                {item.short}
              </span>

              <span className="language-label">
                {item.label}
              </span>

              {language === item.code && (
                <span className="language-selected">
                  <Icon name="check" size={14} />
                </span>
              )}
            </button>
          ))}
        </div>
      )}
    </div>
  )
}

function Login({ language, setLanguage, onLogin }) {
  const t = translations[language]

  const [centerCode, setCenterCode] = useState('')
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [showPassword, setShowPassword] = useState(false)
  const [loading, setLoading] = useState(false)

  const handleSubmit = (event) => {
    event.preventDefault()

    if (!centerCode.trim() || !email.trim() || !password) {
      return
    }

    setLoading(true)

    setTimeout(() => {
      setLoading(false)
      onLogin()
    }, 700)
  }

  return (
    <main
      className={`login-page ${
        language === 'ar' ? 'rtl' : ''
      }`}
    >
      <div className="login-background">
        <div className="background-grid" />
        <div className="background-orb orb-one" />
        <div className="background-orb orb-two" />
        <div className="background-orb orb-three" />
      </div>

      <header className="login-topbar">
        <LanguageSelector
          language={language}
          setLanguage={setLanguage}
        />
      </header>

      <section className="login-card">
        <div className="login-card-glow" />

        <div className="brand">
          <div className="brand-logo-container">
            <img
              src="/logo.png"
              alt="CenterOS"
              className="brand-logo"
            />
          </div>

          <div className="brand-name">
            CenterOS
          </div>

          <div className="brand-line">
            Management Platform
          </div>
        </div>

        <div className="login-heading">
          <h1>{t.welcome}</h1>
          <p>{t.subtitle}</p>
        </div>

        <form
          className="login-form"
          onSubmit={handleSubmit}
        >
          <div className="form-field">
            <label htmlFor="center-code">
              {t.centerCode}
            </label>

            <div className="input-wrapper">
              <span className="input-icon">
                <Icon name="building" size={19} />
              </span>

              <input
                id="center-code"
                type="text"
                value={centerCode}
                onChange={(event) =>
                  setCenterCode(event.target.value)
                }
                placeholder={t.centerPlaceholder}
                autoComplete="organization"
                spellCheck="false"
                required
              />
            </div>
          </div>

          <div className="form-field">
            <label htmlFor="email">
              {t.email}
            </label>

            <div className="input-wrapper">
              <span className="input-icon">
                <Icon name="mail" size={19} />
              </span>

              <input
                id="email"
                type="email"
                value={email}
                onChange={(event) =>
                  setEmail(event.target.value)
                }
                placeholder={t.emailPlaceholder}
                autoComplete="email"
                required
              />
            </div>
          </div>

          <div className="form-field">
            <label htmlFor="password">
              {t.password}
            </label>

            <div className="input-wrapper password-wrapper">
              <span className="input-icon">
                <Icon name="lock" size={19} />
              </span>

              <input
                id="password"
                type={showPassword ? 'text' : 'password'}
                value={password}
                onChange={(event) =>
                  setPassword(event.target.value)
                }
                placeholder={t.passwordPlaceholder}
                autoComplete="current-password"
                required
              />

              <button
                type="button"
                className="password-toggle"
                onClick={() =>
                  setShowPassword((value) => !value)
                }
              >
                <Icon
                  name={showPassword ? 'eyeOff' : 'eye'}
                  size={19}
                />
              </button>
            </div>
          </div>

          <button
            type="submit"
            className="sign-in-button"
            disabled={loading}
          >
            <span>
              {loading ? t.signingIn : t.signIn}
            </span>

            {!loading && (
              <span className="button-arrow">
                <Icon name="arrow" size={18} />
              </span>
            )}

            {loading && (
              <span className="button-loader" />
            )}
          </button>
        </form>

        <div className="login-footer">
          {t.footer}
        </div>
      </section>

      <div className="login-bottom">
        <span>
          © {new Date().getFullYear()} CenterOS
        </span>

        <span className="bottom-separator" />

        <span>All rights reserved</span>
      </div>
    </main>
  )
}

function Dashboard({ language, onLogout }) {
  return (
    <main
      className={`dashboard-placeholder ${
        language === 'ar' ? 'rtl' : ''
      }`}
    >
      <div className="dashboard-placeholder-card">
        <img src="/logo.png" alt="CenterOS" />

        <h1>CenterOS</h1>

        <p>Dashboard will be connected here.</p>

        <button type="button" onClick={onLogout}>
          {language === 'ar'
            ? 'تسجيل الخروج'
            : language === 'tr'
              ? 'Çıkış Yap'
              : 'Log out'}
        </button>
      </div>
    </main>
  )
}

function App() {
  const [language, setLanguage] = useState(() => {
    return localStorage.getItem('centeros_language') || 'en'
  })

  const [view, setView] = useState('login')

  useEffect(() => {
    localStorage.setItem(
      'centeros_language',
      language
    )

    document.documentElement.lang = language
    document.documentElement.dir =
      language === 'ar' ? 'rtl' : 'ltr'
  }, [language])

  return view === 'login' ? (
    <Login
      language={language}
      setLanguage={setLanguage}
      onLogin={() => setView('dashboard')}
    />
  ) : (
    <Dashboard
      language={language}
      onLogout={() => setView('login')}
    />
  )
}

export default App
