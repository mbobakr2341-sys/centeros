@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --primary: #6547e9;
  --primary-dark: #4f32c9;
  --primary-light: #f0edff;
  --blue: #2f7cf6;
  --navy: #14205b;
  --text: #18245d;
  --muted: #68739b;
  --border: #e5e8f4;
  --background: #f8f9fe;
  --white: #ffffff;
  --green: #25b978;
  --shadow: 0 18px 50px rgba(54, 49, 123, 0.10);
  --radius: 24px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: "Inter", Arial, sans-serif;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  max-width: 100%;
  display: block;
}

.public-site {
  min-height: 100vh;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 85% 12%, rgba(119, 87, 255, 0.09), transparent 28%),
    linear-gradient(180deg, #ffffff 0%, #f8f9fe 100%);
}

.container {
  width: min(1160px, calc(100% - 48px));
  margin: 0 auto;
}

/* =========================
   TOP LAUNCH BAR
========================= */

.launch-bar {
  height: 42px;
  background: #171c3a;
  color: #fff;
}

.launch-content {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
}

.launch-label {
  font-size: 13px;
  font-weight: 600;
}

.launch-countdown {
  display: flex;
  align-items: center;
  gap: 18px;
}

.launch-countdown div {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.launch-countdown strong {
  font-size: 14px;
  font-weight: 800;
}

.launch-countdown small {
  color: #aeb5d4;
  font-size: 10px;
}

/* =========================
   HEADER
========================= */

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.97);
  border-bottom: 1px solid #edf0f7;
  box-shadow: 0 5px 24px rgba(35, 35, 91, 0.05);
}

.header-inner {
  height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.brand {
  border: 0;
  background: transparent;
  padding: 0;
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--navy);
}

.brand img {
  width: 48px;
  height: 48px;
  object-fit: contain;
}

.brand span {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1;
}

.brand strong:first-child {
  font-size: 16px;
  color: #263260;
}

.brand strong:last-child {
  font-size: 17px;
  color: var(--primary);
}

.desktop-navigation {
  display: flex;
  align-items: center;
  gap: 34px;
  margin-left: auto;
  margin-right: auto;
}

.desktop-navigation button,
.footer-nav button {
  border: 0;
  background: transparent;
  color: #59648c;
  font-size: 13px;
  font-weight: 600;
  padding: 8px 0;
  transition: color .2s ease;
}

.desktop-navigation button:hover,
.desktop-navigation button.active,
.footer-nav button:hover {
  color: var(--primary);
}

.header-tools {
  display: flex;
  align-items: center;
  gap: 10px;
}

.language-control {
  position: relative;
}

.language-trigger {
  min-height: 40px;
  border: 1px solid var(--border);
  background: #fff;
  border-radius: 12px;
  padding: 0 13px;
  color: #4e5980;
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  font-weight: 600;
}

.language-trigger b {
  font-size: 14px;
  font-weight: 500;
  margin-left: 2px;
}

.language-dropdown {
  position: absolute;
  right: 0;
  top: calc(100% + 8px);
  width: 140px;
  padding: 7px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: var(--shadow);
}

.language-dropdown button {
  width: 100%;
  border: 0;
  background: transparent;
  text-align: left;
  border-radius: 9px;
  padding: 10px;
  color: #4e5980;
  font-size: 12px;
}

.language-dropdown button:hover {
  background: var(--primary-light);
  color: var(--primary);
}

.theme-button {
  width: 40px;
  height: 40px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #fff;
  color: #4e5980;
  display: grid;
  place-items: center;
}

.header-book-button,
.booking-button {
  border: 0;
  background: linear-gradient(100deg, #7048eb, #4e91f8);
  color: #fff;
  border-radius: 12px;
  min-height: 40px;
  padding: 0 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-size: 12px;
  font-weight: 700;
  box-shadow: 0 9px 22px rgba(101, 71, 233, .20);
}

.mobile-menu-button,
.mobile-navigation {
  display: none;
}

/* =========================
   HERO
========================= */

.hero {
  position: relative;
  padding: 72px 0 74px;
  overflow: hidden;
  background:
    radial-gradient(circle at 88% 25%, rgba(122, 82, 245, .15), transparent 33%),
    radial-gradient(circle at 58% 75%, rgba(60, 132, 246, .08), transparent 30%),
    #fff;
}

.hero::after {
  content: "";
  position: absolute;
  width: 560px;
  height: 560px;
  border-radius: 50%;
  right: -230px;
  top: -160px;
  background: radial-gradient(circle, rgba(121, 79, 239, .10), transparent 68%);
  pointer-events: none;
}

.hero-inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: .88fr 1.12fr;
  align-items: center;
  gap: 58px;
}

.hero-copy {
  padding-bottom: 12px;
}

.hero-badge,
.section-tag {
  display: inline-flex;
  align-items: center;
  border: 1px solid #ddd7ff;
  background: #f4f1ff;
  color: var(--primary);
  border-radius: 999px;
  padding: 7px 12px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .04em;
  text-transform: uppercase;
}

.hero h1 {
  margin: 22px 0 19px;
  color: var(--navy);
  font-size: clamp(38px, 4.2vw, 57px);
  line-height: 1.05;
  letter-spacing: -1.8px;
  font-weight: 800;
}

.hero h1 span {
  background: linear-gradient(95deg, #6547e9, #3d8cf4);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-copy > p {
  max-width: 545px;
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.8;
}

.hero-highlights {
  margin-top: 30px;
  display: flex;
  gap: 19px;
}

.hero-highlights > div {
  display: flex;
  align-items: center;
  gap: 8px;
}

.hero-highlights > div > span {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  color: var(--primary);
  background: var(--primary-light);
}

.hero-highlights strong,
.hero-highlights small {
  display: block;
}

.hero-highlights strong {
  font-size: 10px;
  color: #3a4772;
}

.hero-highlights small {
  margin-top: 2px;
  color: #8a93b1;
  font-size: 9px;
}

/* =========================
   DASHBOARD MOCKUP
========================= */

.hero-visual {
  min-width: 0;
}

.dashboard-mockup {
  width: 100%;
  border-radius: 19px;
  background: #fff;
  border: 1px solid #dfe3f2;
  box-shadow: 0 28px 70px rgba(58, 50, 137, .17);
  overflow: hidden;
  transform: perspective(1300px) rotateY(-2deg);
}

.mockup-browser {
  height: 39px;
  background: #f7f8fc;
  border-bottom: 1px solid #e7eaf3;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 13px;
}

.browser-dots {
  display: flex;
  gap: 5px;
}

.browser-dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #d3d7e7;
}

.browser-address {
  flex: 1;
  height: 23px;
  border-radius: 7px;
  background: #fff;
  border: 1px solid #e7e9f2;
  color: #a2a9bd;
  display: flex;
  align-items: center;
  padding: 0 9px;
  font-size: 7px;
}

.browser-user {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #6c7592;
  font-size: 8px;
}

.mini-avatar {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: linear-gradient(135deg, #7553ed, #4891f5);
}

.mockup-layout {
  min-height: 360px;
  display: grid;
  grid-template-columns: 125px 1fr;
}

.mockup-sidebar {
  padding: 15px 9px;
  background: #171d4b;
}

.mockup-logo {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #fff;
  margin: 0 5px 20px;
}

.mockup-logo img {
  width: 25px;
  height: 25px;
  object-fit: contain;
}

.mockup-logo strong {
  font-size: 9px;
}

.mockup-nav {
  height: 31px;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 0 8px;
  margin-bottom: 3px;
  border-radius: 7px;
  color: #9da7cf;
  font-size: 7px;
}

.mockup-nav span {
  width: 9px;
  height: 9px;
  border-radius: 3px;
  border: 1px solid currentColor;
}

.mockup-nav.active {
  background: rgba(111, 82, 234, .28);
  color: #fff;
}

.mockup-main {
  min-width: 0;
  padding: 18px;
  background: #f9faff;
}

.mockup-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.mockup-heading small {
  color: #8992ad;
  font-size: 7px;
}

.mockup-heading h3 {
  margin: 3px 0 0;
  color: #202d65;
  font-size: 13px;
}

.mockup-search {
  width: 100px;
  height: 24px;
  border: 1px solid #e3e6f1;
  border-radius: 7px;
  background: #fff;
  color: #a3a9bb;
  font-size: 7px;
  display: flex;
  align-items: center;
  padding: 0 8px;
}

.mockup-stat-grid {
  margin-top: 17px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.mockup-stat {
  min-width: 0;
  padding: 11px;
  background: #fff;
  border: 1px solid #e5e8f1;
  border-radius: 9px;
}

.mockup-stat small {
  display: block;
  color: #8790ad;
  font-size: 6px;
}

.mockup-stat strong {
  display: block;
  margin: 6px 0 2px;
  color: #253267;
  font-size: 15px;
}

.mockup-stat em {
  color: #23ad74;
  font-size: 6px;
  font-style: normal;
}

.mockup-lower {
  margin-top: 10px;
  display: grid;
  grid-template-columns: 1.35fr .9fr;
  gap: 10px;
}

.mockup-chart,
.mockup-activity {
  min-width: 0;
  background: #fff;
  border: 1px solid #e5e8f1;
  border-radius: 10px;
  padding: 12px;
}

.mockup-card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.mockup-card-title strong {
  font-size: 7px;
  color: #28366e;
}

.mockup-card-title span {
  font-size: 6px;
  color: #9aa2ba;
}

.chart-area {
  height: 115px;
  margin-top: 10px;
  display: flex;
  align-items: flex-end;
  gap: 7px;
  padding: 0 8px 2px;
  border-bottom: 1px solid #eef0f6;
}

.chart-bar {
  flex: 1;
  max-width: 20px;
  margin: 0 auto;
  border-radius: 4px 4px 0 0;
  background: linear-gradient(180deg, #7753ed, #6b8ef2);
  min-height: 15px;
}

.activity-item {
  margin-top: 10px;
  display: flex;
  align-items: center;
  gap: 7px;
}

.activity-item i {
  flex: 0 0 auto;
  width: 22px;
  height: 22px;
  border-radius: 7px;
  display: grid;
  place-items: center;
  background: #eeeaff;
  color: #6749df;
  font-size: 6px;
  font-style: normal;
  font-weight: 700;
}

.activity-item strong,
.activity-item small {
  display: block;
}

.activity-item strong {
  color: #4d577b;
  font-size: 6px;
}

.activity-item small {
  margin-top: 2px;
  color: #a1a7ba;
  font-size: 5px;
}

/* =========================
   FEATURE STRIP
========================= */

.feature-strip {
  position: relative;
  z-index: 2;
  margin-top: -8px;
}

.feature-strip-inner {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.strip-item {
  min-height: 126px;
  padding: 23px 21px;
  display: flex;
  align-items: flex-start;
  gap: 13px;
  border-right: 1px solid #edf0f6;
}

.strip-item:last-child {
  border-right: 0;
}

.strip-icon,
.plan-icon,
.about-points > div > span,
.booking-detail > span {
  flex: 0 0 auto;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  color: var(--primary);
  background: var(--primary-light);
}

.strip-item strong {
  color: #263365;
  font-size: 12px;
}

.strip-item p {
  margin: 7px 0 0;
  color: #7d86a4;
  font-size: 10px;
  line-height: 1.6;
}

/* =========================
   PACKAGES
========================= */

.packages {
  padding: 92px 0 96px;
}

.packages-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 35px;
  margin-bottom: 35px;
}

.packages-heading h2,
.about-copy h2,
.booking-copy h2 {
  margin: 13px 0 8px;
  color: var(--navy);
  font-size: 35px;
  line-height: 1.15;
  letter-spacing: -.8px;
}

.packages-heading p {
  max-width: 520px;
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.billing-control {
  position: relative;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 3px;
  padding: 4px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 13px;
}

.billing-control button {
  border: 0;
  background: transparent;
  color: #737c9c;
  border-radius: 9px;
  padding: 9px 15px;
  font-size: 10px;
  font-weight: 700;
}

.billing-control button.active {
  background: var(--primary);
  color: #fff;
}

.billing-control span {
  position: absolute;
  right: -48px;
  top: -17px;
  padding: 4px 7px;
  border-radius: 5px;
  background: #28bd7b;
  color: #fff;
  font-size: 7px;
  font-weight: 800;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.pricing-card {
  position: relative;
  min-width: 0;
  min-height: 445px;
  padding: 25px 20px 19px;
  display: flex;
  flex-direction: column;
  background: #fff;
  border: 1px solid #e1e5f1;
  border-radius: 18px;
  box-shadow: 0 9px 28px rgba(49, 48, 112, .055);
}

.pricing-card.popular {
  border: 1.5px solid #7657ed;
  box-shadow: 0 16px 38px rgba(91, 65, 211, .14);
}

.popular-badge {
  position: absolute;
  right: 15px;
  top: -11px;
  padding: 6px 9px;
  border-radius: 6px;
  color: #fff;
  background: linear-gradient(100deg, #7048eb, #4c91f6);
  font-size: 8px;
  font-weight: 800;
}

.plan-icon {
  width: 48px;
  height: 48px;
}

.pricing-card h3 {
  margin: 17px 0 5px;
  color: #263365;
  font-size: 18px;
}

.plan-subtitle {
  min-height: 34px;
  margin: 0;
  color: #8991ad;
  font-size: 10px;
  line-height: 1.55;
}

.plan-price {
  min-height: 68px;
  display: flex;
  align-items: flex-end;
  gap: 5px;
  margin-top: 10px;
}

.plan-price strong {
  color: #1d2a64;
  font-size: 27px;
  letter-spacing: -.7px;
}

.plan-price small {
  color: #8991ad;
  font-size: 9px;
  margin-bottom: 5px;
}

.plan-line {
  height: 1px;
  background: #edf0f5;
  margin: 7px 0 14px;
}

.pricing-card ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.pricing-card li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 11px;
  color: #626d91;
  font-size: 10px;
  line-height: 1.35;
}

.pricing-card li span {
  color: var(--green);
  font-weight: 900;
}

.plan-button {
  width: 100%;
  height: 38px;
  margin-top: auto;
  border: 1px solid #cfd4e8;
  border-radius: 9px;
  background: #fff;
  color: var(--primary);
  font-size: 10px;
  font-weight: 800;
}

.pricing-card.popular .plan-button {
  border-color: transparent;
  background: linear-gradient(100deg, #7048eb, #4b91f7);
  color: #fff;
}

/* =========================
   ABOUT
========================= */

.about {
  padding: 94px 0;
  background: #fff;
  border-top: 1px solid #edf0f6;
  border-bottom: 1px solid #edf0f6;
}

.about-inner {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  align-items: center;
  gap: 70px;
}

.about-copy > p {
  max-width: 520px;
  margin: 0;
  color: #707b9e;
  font-size: 13px;
  line-height: 1.85;
}

.about-points {
  margin-top: 29px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px 25px;
}

.about-points > div {
  display: flex;
  align-items: center;
  gap: 10px;
}

.about-points > div > span {
  width: 38px;
  height: 38px;
  border-radius: 10px;
}

.about-points strong,
.about-points small {
  display: block;
}

.about-points strong {
  color: #3c4771;
  font-size: 10px;
}

.about-points small {
  margin-top: 3px;
  color: #949bb2;
  font-size: 8px;
}

.about-devices {
  position: relative;
  min-height: 390px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.device-glow {
  position: absolute;
  width: 350px;
  height: 350px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(105, 72, 233, .15), transparent 65%);
}

.laptop {
  position: relative;
  z-index: 1;
  width: 470px;
}

.laptop-screen {
  padding: 9px;
  background: #1c2250;
  border-radius: 12px 12px 5px 5px;
  border: 4px solid #d9dced;
  box-shadow: 0 20px 45px rgba(38, 39, 100, .17);
}

.laptop-screen .dashboard-mockup {
  transform: none;
  box-shadow: none;
  border-radius: 5px;
}

.laptop-screen .mockup-layout {
  min-height: 270px;
}

.laptop-base {
  height: 11px;
  width: 108%;
  margin-left: -4%;
  border-radius: 0 0 14px 14px;
  background: linear-gradient(180deg, #d7d9e7, #aeb3ca);
}

.phone {
  position: absolute;
  z-index: 3;
  right: 0;
  bottom: 2px;
  width: 130px;
  height: 260px;
  padding: 31px 11px 12px;
  border-radius: 22px;
  border: 5px solid #252b57;
  background: #fff;
  box-shadow: 0 20px 45px rgba(38, 39, 100, .22);
}

.phone-top {
  position: absolute;
  top: 7px;
  left: 50%;
  transform: translateX(-50%);
  width: 45px;
  height: 7px;
  border-radius: 20px;
  background: #252b57;
}

.phone img {
  width: 35px;
  height: 35px;
  margin: 0 auto 3px;
}

.phone > strong {
  display: block;
  text-align: center;
  color: var(--primary);
  font-size: 9px;
  margin-bottom: 12px;
}

.phone-item {
  height: 25px;
  margin-bottom: 4px;
  padding: 0 8px;
  display: flex;
  align-items: center;
  border-radius: 6px;
  color: #8991aa;
  background: #f7f8fc;
  font-size: 7px;
}

.phone-item.active {
  color: var(--primary);
  background: #eeeaff;
}

/* =========================
   BOOKING CTA
========================= */

.booking {
  padding: 78px 0;
  background: #f8f9fe;
}

.booking-card {
  padding: 42px 48px;
  display: grid;
  grid-template-columns: 1fr .82fr;
  gap: 50px;
  align-items: center;
  border-radius: 24px;
  background:
    radial-gradient(circle at 90% 20%, rgba(92, 130, 255, .23), transparent 34%),
    linear-gradient(120deg, #f0edff, #edf5ff);
  border: 1px solid #dfe4f5;
}

.booking-copy h2 {
  max-width: 570px;
  font-size: 32px;
}

.booking-copy p {
  max-width: 560px;
  margin: 0;
  color: #6f7999;
  font-size: 13px;
  line-height: 1.8;
}

.booking-details {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.booking-detail {
  display: flex;
  align-items: center;
  gap: 11px;
}

.booking-detail > span {
  width: 39px;
  height: 39px;
}

.booking-detail small,
.booking-detail strong {
  display: block;
}

.booking-detail small {
  color: #8b94af;
  font-size: 8px;
  margin-bottom: 3px;
}

.booking-detail strong {
  color: #34406b;
  font-size: 10px;
}

.booking-button {
  margin-top: 7px;
  width: 150px;
  height: 41px;
}

/* =========================
   FOOTER
========================= */

.footer {
  background: #fff;
  border-top: 1px solid #e7eaf2;
}

.footer-inner {
  min-height: 125px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 35px;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 7px;
}

.footer-logo img {
  width: 38px;
  height: 38px;
}

.footer-logo span {
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.footer-logo strong:first-child {
  font-size: 12px;
  color: #2b3566;
}

.footer-logo strong:last-child {
  color: var(--primary);
  font-size: 13px;
}

.footer-brand p {
  margin: 6px 0 0;
  color: #9aa1b7;
  font-size: 8px;
}

.footer-brand p span {
  margin: 0 5px;
}

.footer-nav {
  display: flex;
  gap: 23px;
}

.footer-nav button {
  font-size: 9px;
}

.footer-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}

.footer-right a {
  color: var(--primary);
  text-decoration: none;
  font-size: 9px;
  font-weight: 700;
}

.footer-right span {
  color: #a1a7b9;
  font-size: 7px;
}

/* =========================
   RTL
========================= */

.public-site.rtl {
  direction: rtl;
}

.public-site.rtl .brand span,
.public-site.rtl .language-dropdown button {
  text-align: right;
}

.public-site.rtl .hero-highlights,
.public-site.rtl .strip-item,
.public-site.rtl .about-points > div,
.public-site.rtl .booking-detail {
  flex-direction: row;
}

.public-site.rtl .language-dropdown {
  right: auto;
  left: 0;
}

