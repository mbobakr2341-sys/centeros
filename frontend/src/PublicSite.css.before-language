/* =========================================================
   CenterOS Booking Modal
   ========================================================= */

.booking-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(12, 10, 28, 0.58);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.booking-modal {
  position: relative;
  width: min(680px, 100%);
  max-height: min(820px, calc(100vh - 48px));
  overflow-y: auto;
  padding: 34px;
  border: 1px solid rgba(109, 74, 255, 0.16);
  border-radius: 24px;
  background: #ffffff;
  box-shadow: 0 30px 90px rgba(27, 20, 65, 0.28);
}

.booking-modal-close {
  position: absolute;
  top: 18px;
  right: 18px;
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border: 1px solid #e5e2ef;
  border-radius: 12px;
  background: #ffffff;
  color: #34304a;
  font-size: 26px;
  line-height: 1;
  cursor: pointer;
  transition: 0.2s ease;
}

.booking-modal-close:hover {
  border-color: #6d4aff;
  color: #6d4aff;
  transform: translateY(-1px);
}

.booking-modal-header {
  padding-right: 48px;
  margin-bottom: 26px;
}

.booking-modal-eyebrow {
  display: inline-block;
  margin-bottom: 9px;
  color: #6d4aff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.booking-modal-header h2 {
  margin: 0 0 8px;
  color: #17142b;
  font-size: clamp(28px, 4vw, 38px);
  line-height: 1.1;
}

.booking-modal-header p {
  margin: 0;
  color: #77728a;
  font-size: 15px;
  line-height: 1.65;
}

.booking-modal-form {
  display: grid;
  gap: 18px;
}

.booking-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.booking-modal-form label {
  display: grid;
  gap: 8px;
}

.booking-modal-form label > span {
  color: #29243d;
  font-size: 13px;
  font-weight: 700;
}

.booking-modal-form input,
.booking-modal-form select,
.booking-modal-form textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #ddd9e9;
  border-radius: 13px;
  outline: none;
  background: #fbfaff;
  color: #242039;
  font: inherit;
  font-size: 14px;
  transition: 0.2s ease;
}

.booking-modal-form input,
.booking-modal-form select {
  height: 48px;
  padding: 0 14px;
}

.booking-modal-form textarea {
  min-height: 112px;
  padding: 13px 14px;
  resize: vertical;
}

.booking-modal-form input:focus,
.booking-modal-form select:focus,
.booking-modal-form textarea:focus {
  border-color: #7a5cff;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(109, 74, 255, 0.09);
}

.booking-submit-button {
  width: 100%;
  min-height: 52px;
  margin-top: 2px;
  border: 0;
  border-radius: 13px;
  background: linear-gradient(135deg, #6d4aff, #4f7cff);
  color: #ffffff;
  font: inherit;
  font-size: 14px;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 12px 26px rgba(109, 74, 255, 0.22);
  transition: 0.2s ease;
}

.booking-submit-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 15px 30px rgba(109, 74, 255, 0.28);
}

.booking-modal-note {
  margin: -4px 0 0;
  color: #918ca1;
  font-size: 12px;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 650px) {
  .booking-modal-overlay {
    align-items: flex-end;
    padding: 12px;
  }

  .booking-modal {
    max-height: calc(100vh - 24px);
    padding: 26px 20px 22px;
    border-radius: 22px;
  }

  .booking-form-grid {
    grid-template-columns: 1fr;
  }

  .booking-modal-header {
    padding-right: 42px;
  }
}
